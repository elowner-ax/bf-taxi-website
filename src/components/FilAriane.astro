---
import type { FilAriane as TypeFilAriane } from '../lib/schema.ts';

interface Props {
  elements: TypeFilAriane;
}

const { elements } = Astro.props;
---

<nav class="ariane" aria-label="Fil d'Ariane">
  <div class="conteneur">
    <ol>
      {
        elements.map((el, i) => (
          <li>
            {i < elements.length - 1 ? (
              <a href={el.url}>{el.nom}</a>
            ) : (
              <span aria-current="page">{el.nom}</span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .ariane {
    padding-block: 1.15rem 0;
    font-size: 0.81rem;
  }

  .ariane ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--texte-3);
  }

  .ariane li + li::before {
    content: '›';
    margin-right: 0.45rem;
    opacity: 0.6;
  }

  .ariane a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ariane [aria-current] {
    color: var(--texte-2);
  }
</style>
