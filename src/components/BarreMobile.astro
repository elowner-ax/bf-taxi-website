---
/**
 * Barre d'action fixe en bas d'écran sur mobile. La majorité des appels part
 * d'ici : elle doit rester atteignable sans faire défiler la page.
 */
import Icone from './Icone.astro';
import { CONTACT } from '../data/site.ts';
---

<div class="barre">
  <a href={`tel:${CONTACT.phone}`} class="barre__lien barre__lien--appel" data-evt="tel-barre">
    <Icone nom="phone" taille={20} />
    <span>Appeler</span>
  </a>
  <a
    href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver un taxi.')}`}
    class="barre__lien"
    rel="noopener"
    target="_blank"
    data-evt="whatsapp-barre"
  >
    <Icone nom="whatsapp" taille={20} />
    <span>WhatsApp</span>
  </a>
  <a href="/devis/" class="barre__lien">
    <Icone nom="doc" taille={20} />
    <span>Devis</span>
  </a>
</div>

<style>
  .barre {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--blanc);
    border-top: 1px solid var(--filet-fort);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .barre__lien {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.7rem 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texte-2);
  }

  .barre__lien + .barre__lien {
    border-left: 1px solid var(--filet);
  }

  .barre__lien--appel {
    color: var(--chaud);
  }

  .barre__lien:active {
    background: var(--ivoire);
  }

  @media (min-width: 1080px) {
    .barre {
      display: none;
    }
  }
</style>

<style is:global>
  /* Réserve la hauteur de la barre pour ne pas masquer le pied de page. */
  @media (max-width: 1079px) {
    body {
      padding-bottom: 70px;
    }
  }
</style>
