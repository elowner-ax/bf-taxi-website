---
import Icone from './Icone.astro';
import BoutonRappel from './BoutonRappel.astro';
import { CONTACT } from '../data/site.ts';

interface Props {
  titre?: string;
  texte?: string;
  /** Variante sur fond encre, pour clore une page de service. */
  encre?: boolean;
}

const {
  titre = 'Besoin d’un taxi maintenant ?',
  texte = `Un appel suffit. Nous organisons votre trajet en conventionné comme en course classique, à Saint-Étienne et dans toute la Loire.`,
  encre = false,
} = Astro.props;
---

<section class:list={['cta', encre ? 'section-encre' : 'section-ivoire']}>
  <div class="conteneur cta__inner">
    <div class="cta__texte">
      <h2>{titre}</h2>
      <p>{texte}</p>
    </div>
    <div class="groupe-btn">
      <a href={`tel:${CONTACT.phone}`} class="btn btn-appel btn-large" data-evt="tel-cta">
        <Icone nom="phone" taille={18} />
        {CONTACT.phoneDisplay}
      </a>
      <a href="/devis/" class="btn btn-contour btn-large">Devis en ligne</a>
      <BoutonRappel variante="contour" libelle="Être rappelé" />
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(2.75rem, 5vw, 3.9rem);
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3.5rem;
  }

  .cta__texte {
    flex: 1 1 380px;
  }

  .cta__texte h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
  }

  .cta__texte p {
    color: var(--texte-2);
    margin-top: 0.75rem;
    max-width: 52ch;
    font-size: 1.02rem;
  }
</style>
