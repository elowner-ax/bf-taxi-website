---
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { CONTACT } from '../data/site.ts';
import { SERVICES, CATEGORIES, servicesParCategorie, type Service } from '../data/services.ts';

const chemin = Astro.url.pathname;
const estActif = (href: string) => chemin === href || (href !== '/' && chemin.startsWith(href));

const categories = (Object.keys(CATEGORIES) as Service['categorie'][]).map((cle) => ({
  cle,
  ...CATEGORIES[cle],
  services: servicesParCategorie(cle),
}));

const liens = [
  { href: '/tarifs/', label: 'Tarifs' },
  { href: '/vehicules/', label: 'Véhicules' },
  { href: '/taxi/', label: 'Zones' },
  { href: '/faq/', label: 'FAQ' },
];
---

<!-- Bandeau de conventionnement : l'argument commercial n°1, visible d'emblée. -->
<div class="bandeau">
  <div class="conteneur bandeau__inner">
    <Icone nom="shield" taille={15} />
    <span>Conventionné par l’Assurance Maladie — transport médical sans avance de frais</span>
  </div>
</div>

<header class="entete" data-entete>
  <div class="conteneur entete__inner">
    <a href="/" class="entete__logo" aria-label="BF Taxi — accueil">
      <Logo />
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <div class="nav__item nav__item--menu">
        <button
          type="button"
          class:list={['nav__lien', { actif: SERVICES.some((s) => chemin.startsWith(`/${s.slug}/`)) }]}
          aria-expanded="false"
          aria-controls="megamenu"
          data-declencheur
        >
          Nos services
          <Icone nom="chevron" taille={14} class="nav__chevron" />
        </button>

        <div class="mega" id="megamenu" data-mega>
          <div class="mega__grille">
            {
              categories.map((cat) => (
                <div class="mega__colonne">
                  <p class="mega__titre">{cat.label}</p>
                  <p class="mega__desc">{cat.description}</p>
                  <ul>
                    {cat.services.map((service) => (
                      <li>
                        <a href={`/${service.slug}/`} class:list={[{ actif: estActif(`/${service.slug}/`) }]}>
                          <Icone nom={service.icon} taille={17} />
                          <span>{service.navLabel}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="mega__pied">
            <div>
              <strong>Besoin d’une estimation&nbsp;?</strong>
              <span>Simulateur en ligne, basé sur les tarifs préfectoraux de la Loire.</span>
            </div>
            <a href="/tarifs/#simulateur" class="btn btn-encre">
              <Icone nom="euro" taille={17} /> Estimer ma course
            </a>
          </div>
        </div>
      </div>

      {
        liens.map((lien) => (
          <a href={lien.href} class:list={['nav__lien', { actif: estActif(lien.href) }]}>
            {lien.label}
          </a>
        ))
      }
    </nav>

    <div class="entete__actions">
      <a href="/devis/" class="btn btn-contour entete__devis">Devis</a>
      <a href={`tel:${CONTACT.phone}`} class="btn btn-appel entete__tel" data-evt="tel-header">
        <Icone nom="phone" taille={16} />
        <span>{CONTACT.phoneDisplay}</span>
      </a>

      <button type="button" class="burger" aria-label="Ouvrir le menu" aria-expanded="false" data-burger>
        <Icone nom="menu" taille={24} />
      </button>
    </div>
  </div>

  <div class="mobile" data-menu-mobile hidden>
    <div class="mobile__contenu">
      {
        categories.map((cat) => (
          <div class="mobile__groupe">
            <p class="mobile__titre">{cat.label}</p>
            {cat.services.map((service) => (
              <a href={`/${service.slug}/`}>
                <Icone nom={service.icon} taille={18} />
                {service.navLabel}
              </a>
            ))}
          </div>
        ))
      }

      <div class="mobile__groupe">
        <p class="mobile__titre">Informations</p>
        {liens.map((lien) => <a href={lien.href}>{lien.label}</a>)}
        <a href="/a-propos/">À propos</a>
        <a href="/contact/">Contact</a>
        <a href="/devis/">Demander un devis</a>
      </div>

      <div class="mobile__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-appel btn-large">
          <Icone nom="phone" taille={18} /> {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}`}
          class="btn btn-contour btn-large"
          rel="noopener"
          target="_blank"
        >
          <Icone nom="whatsapp" taille={18} /> WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .bandeau {
    background: var(--encre);
    color: var(--sur-encre);
    font-size: 0.84rem;
  }

  .bandeau__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-block: 0.7rem;
    text-align: center;
  }

  .bandeau :global(svg) {
    flex-shrink: 0;
  }

  .entete {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--blanc);
    border-bottom: 1px solid var(--filet);
  }

  .entete__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
  }

  .entete__logo {
    flex-shrink: 0;
  }

  /* --- Navigation bureau --- */
  .nav {
    display: none;
    align-items: center;
    gap: 0.35rem;
    margin-inline: auto;
  }

  .nav__lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.7rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--texte-2);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .nav__lien:hover {
    color: var(--texte);
  }

  .nav__lien.actif {
    color: var(--encre);
    font-weight: 600;
    border-bottom-color: var(--chaud);
  }

  .nav :global(.nav__chevron) {
    transition: transform var(--transition);
  }

  .nav__item--menu {
    position: static;
  }

  .nav__item--menu[data-ouvert] :global(.nav__chevron) {
    transform: rotate(180deg);
  }

  /* --- Méga-menu --- */
  .mega {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 0;
    right: 0;
    width: min(880px, 100%);
    margin-inline: auto;
    background: var(--blanc);
    border: 1px solid var(--filet-fort);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  .nav__item--menu[data-ouvert] .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .mega__grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    padding: 1.75rem;
  }

  .mega__titre {
    font-family: var(--font-titre);
    font-size: 1.05rem;
    color: var(--encre);
    margin-bottom: 0.3rem;
  }

  .mega__desc {
    font-size: 0.8rem;
    color: var(--texte-3);
    line-height: 1.5;
    margin-bottom: 0.9rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--filet);
  }

  .mega__colonne ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .mega__colonne a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    margin-left: -0.55rem;
    font-size: 0.9rem;
    color: var(--texte-2);
    transition: background-color var(--transition), color var(--transition);
  }

  .mega__colonne a:hover,
  .mega__colonne a.actif {
    background: var(--ivoire);
    color: var(--texte);
  }

  .mega__colonne :global(svg) {
    color: var(--encre);
    flex-shrink: 0;
  }

  .mega__pied {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem 1.75rem;
    background: var(--ivoire);
    border-top: 1px solid var(--filet);
  }

  .mega__pied strong {
    display: block;
    font-size: 0.94rem;
  }

  .mega__pied span {
    font-size: 0.84rem;
    color: var(--texte-3);
  }

  /* --- Actions --- */
  .entete__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .nav ~ .entete__actions {
    margin-left: 0;
  }

  .entete__devis {
    display: none;
    padding: 0.72rem 1.15rem;
    font-size: 0.9rem;
  }

  .entete__tel {
    display: none;
    padding: 0.78rem 1.25rem;
    font-size: 0.92rem;
  }

  .burger {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--filet-fort);
    color: var(--texte);
  }

  .burger:hover {
    background: var(--ivoire);
  }

  /* --- Menu mobile --- */
  .mobile {
    position: fixed;
    inset: 76px 0 0;
    background: var(--blanc);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--filet);
  }

  .mobile__contenu {
    padding: 1.25rem var(--gouttiere) 3rem;
  }

  .mobile__titre {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texte-3);
    margin: 1.5rem 0 0.5rem;
  }

  .mobile__groupe:first-child .mobile__titre {
    margin-top: 0;
  }

  .mobile__groupe a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.15rem;
    font-size: 1rem;
    color: var(--texte-2);
    border-bottom: 1px solid var(--filet-doux);
  }

  .mobile__groupe :global(svg) {
    color: var(--encre);
  }

  .mobile__cta {
    display: grid;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  @media (min-width: 1080px) {
    .nav {
      display: flex;
    }

    .burger {
      display: none;
    }

    .entete__devis,
    .entete__tel {
      display: inline-flex;
    }
  }
</style>

<script>
  const declencheur = document.querySelector<HTMLButtonElement>('[data-declencheur]');
  const itemMenu = declencheur?.closest<HTMLElement>('.nav__item--menu');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menuMobile = document.querySelector<HTMLElement>('[data-menu-mobile]');

  // Méga-menu : ouverture au survol comme au clavier.
  const basculerMega = (ouvert: boolean) => {
    if (!itemMenu || !declencheur) return;
    itemMenu.toggleAttribute('data-ouvert', ouvert);
    declencheur.setAttribute('aria-expanded', String(ouvert));
  };

  declencheur?.addEventListener('click', () => basculerMega(!itemMenu?.hasAttribute('data-ouvert')));
  itemMenu?.addEventListener('mouseenter', () => basculerMega(true));
  itemMenu?.addEventListener('mouseleave', () => basculerMega(false));
  itemMenu?.addEventListener('focusout', (e) => {
    if (!itemMenu.contains(e.relatedTarget as Node)) basculerMega(false);
  });

  const ICONE_MENU =
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
  const ICONE_FERMER =
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>';

  const basculerMobile = (ouvert: boolean) => {
    if (!menuMobile || !burger) return;
    menuMobile.hidden = !ouvert;
    burger.setAttribute('aria-expanded', String(ouvert));
    burger.setAttribute('aria-label', ouvert ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = ouvert ? 'hidden' : '';
    burger.innerHTML = ouvert ? ICONE_FERMER : ICONE_MENU;
  };

  burger?.addEventListener('click', () => basculerMobile(menuMobile?.hidden ?? true));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    basculerMega(false);
    if (menuMobile && !menuMobile.hidden) basculerMobile(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1080 && menuMobile && !menuMobile.hidden) basculerMobile(false);
  });
</script>
