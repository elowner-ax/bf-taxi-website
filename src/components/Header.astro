---
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { CONTACT } from '../data/site.ts';
import { SERVICES, CATEGORIES, servicesParCategorie, type Service } from '../data/services.ts';

const chemin = Astro.url.pathname;
const estActif = (href: string) => chemin === href || (href !== '/' && chemin.startsWith(href));

const categories = (Object.keys(CATEGORIES) as Service['categorie'][]).map((cle) => ({
  cle,
  ...CATEGORIES[cle],
  services: servicesParCategorie(cle),
}));

const liens = [
  { href: '/vehicules/', label: 'Véhicules' },
  { href: '/tarifs/', label: 'Tarifs' },
  { href: '/taxi/', label: 'Zones desservies' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="entete" data-entete>
  <div class="conteneur entete__inner">
    <a href="/" class="entete__logo" aria-label="BF Taxi — accueil">
      <Logo />
    </a>

    <nav class="nav-bureau" aria-label="Navigation principale">
      <div class="nav-item nav-item--menu">
        <button
          type="button"
          class:list={['nav-lien', 'nav-lien--bouton', { actif: SERVICES.some((s) => chemin.startsWith(`/${s.slug}/`)) }]}
          aria-expanded="false"
          aria-controls="megamenu"
          data-declencheur-menu
        >
          Nos services
          <Icone nom="arrow" taille={14} class="nav-chevron" />
        </button>

        <div class="megamenu" id="megamenu" data-megamenu>
          <div class="megamenu__grille">
            {
              categories.map((cat) => (
                <div class="megamenu__colonne">
                  <p class="megamenu__titre">{cat.label}</p>
                  <p class="megamenu__desc">{cat.description}</p>
                  <ul>
                    {cat.services.map((service) => (
                      <li>
                        <a href={`/${service.slug}/`} class:list={[{ actif: estActif(`/${service.slug}/`) }]}>
                          <Icone nom={service.icon} taille={17} />
                          <span>{service.navLabel}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="megamenu__pied">
            <div>
              <strong>Besoin d’une estimation&nbsp;?</strong>
              <span>Simulateur de prix en ligne, basé sur les tarifs préfectoraux.</span>
            </div>
            <a href="/tarifs/#simulateur" class="btn btn-or">
              <Icone nom="euro" taille={17} /> Estimer ma course
            </a>
          </div>
        </div>
      </div>

      {
        liens.map((lien) => (
          <a href={lien.href} class:list={['nav-lien', { actif: estActif(lien.href) }]}>
            {lien.label}
          </a>
        ))
      }
    </nav>

    <div class="entete__actions">
      <a href={`tel:${CONTACT.phone}`} class="entete__tel" data-evt="tel-header">
        <Icone nom="phone" taille={18} />
        <span>{CONTACT.phoneDisplay}</span>
      </a>
      <a href="/devis/" class="btn btn-or entete__devis">Devis gratuit</a>

      <button type="button" class="burger" aria-label="Ouvrir le menu" aria-expanded="false" data-burger>
        <Icone nom="menu" taille={24} />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="menu-mobile" data-menu-mobile hidden>
    <div class="menu-mobile__contenu">
      <p class="menu-mobile__section">Nos services</p>
      {
        categories.map((cat) => (
          <div class="menu-mobile__groupe">
            <p class="menu-mobile__groupe-titre">{cat.label}</p>
            {cat.services.map((service) => (
              <a href={`/${service.slug}/`}>
                <Icone nom={service.icon} taille={18} />
                {service.navLabel}
              </a>
            ))}
          </div>
        ))
      }

      <p class="menu-mobile__section">Le site</p>
      <div class="menu-mobile__groupe">
        {liens.map((lien) => <a href={lien.href}>{lien.label}</a>)}
        <a href="/devis/">Demander un devis</a>
      </div>

      <div class="menu-mobile__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-or btn-large">
          <Icone nom="phone" taille={18} /> {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}`}
          class="btn btn-whatsapp btn-large"
          rel="noopener"
          target="_blank"
        >
          <Icone nom="whatsapp" taille={18} /> WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 9, 12, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: background-color var(--transition), border-color var(--transition);
  }

  .entete[data-scrolled] {
    background: rgba(8, 9, 12, 0.94);
    border-bottom-color: var(--bord);
  }

  .entete__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 74px;
  }

  .entete__logo {
    flex-shrink: 0;
    transition: opacity var(--transition);
  }

  .entete__logo:hover {
    opacity: 0.85;
  }

  /* --- Navigation bureau --- */
  .nav-bureau {
    display: none;
    align-items: center;
    gap: 0.2rem;
    margin-left: auto;
  }

  .nav-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.72rem;
    border-radius: var(--r-full);
    font-size: 0.9rem;
    font-weight: 520;
    white-space: nowrap;
    color: var(--texte-doux);
    transition: color var(--transition), background-color var(--transition);
  }

  .nav-lien:hover,
  .nav-lien.actif {
    color: var(--texte);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-lien.actif {
    color: var(--or-clair);
  }

  .nav-lien :global(.nav-chevron) {
    transform: rotate(90deg);
    transition: transform var(--transition);
  }

  .nav-item--menu {
    position: relative;
  }

  .nav-item--menu[data-ouvert] :global(.nav-chevron) {
    transform: rotate(-90deg);
  }

  /* --- Méga-menu --- */
  .megamenu {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    translate: -50% 0;
    width: min(880px, calc(100vw - 3rem));
    background: var(--noir-2);
    border: 1px solid var(--bord-forte);
    border-radius: var(--r-lg);
    box-shadow: var(--ombre-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
    overflow: hidden;
  }

  .nav-item--menu[data-ouvert] .megamenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .megamenu__grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.75rem;
  }

  .megamenu__titre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--or);
    margin-bottom: 0.3rem;
  }

  .megamenu__desc {
    font-size: 0.82rem;
    color: var(--texte-faible);
    line-height: 1.45;
    margin-bottom: 0.9rem;
  }

  .megamenu__colonne ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .megamenu__colonne a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    margin-left: -0.6rem;
    border-radius: var(--r-sm);
    font-size: 0.9rem;
    color: var(--texte-doux);
    transition: color var(--transition), background-color var(--transition);
  }

  .megamenu__colonne a:hover,
  .megamenu__colonne a.actif {
    background: rgba(255, 255, 255, 0.055);
    color: var(--texte);
  }

  .megamenu__colonne a:hover :global(svg),
  .megamenu__colonne a.actif :global(svg) {
    color: var(--or);
  }

  .megamenu__colonne :global(svg) {
    color: var(--texte-faible);
    transition: color var(--transition);
    flex-shrink: 0;
  }

  .megamenu__pied {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 1.75rem;
    background: rgba(255, 194, 51, 0.05);
    border-top: 1px solid var(--bord);
  }

  .megamenu__pied strong {
    display: block;
    font-size: 0.95rem;
  }

  .megamenu__pied span {
    font-size: 0.85rem;
    color: var(--texte-faible);
  }

  /* --- Actions --- */
  .entete__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .nav-bureau ~ .entete__actions {
    margin-left: 0;
  }

  .entete__tel {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--r-full);
    font-weight: 620;
    font-size: 0.92rem;
    white-space: nowrap;
    color: var(--or-clair);
    border: 1px solid rgba(255, 194, 51, 0.28);
    transition: background-color var(--transition), border-color var(--transition);
  }

  .entete__tel:hover {
    background: rgba(255, 194, 51, 0.1);
    border-color: var(--or);
  }

  .entete__devis {
    display: none;
    padding: 0.72rem 1.25rem;
    font-size: 0.92rem;
  }

  .burger {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-md);
    border: 1px solid var(--bord-forte);
    color: var(--texte);
    transition: background-color var(--transition);
  }

  .burger:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  /* --- Menu mobile --- */
  .menu-mobile {
    position: fixed;
    inset: 74px 0 0;
    background: var(--noir);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: apparition 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes apparition {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .menu-mobile__contenu {
    padding: 1.5rem var(--gouttiere) 3rem;
  }

  .menu-mobile__section {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--or);
    margin: 1.6rem 0 0.7rem;
  }

  .menu-mobile__section:first-child {
    margin-top: 0;
  }

  .menu-mobile__groupe {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.5rem;
  }

  .menu-mobile__groupe-titre {
    font-size: 0.82rem;
    color: var(--texte-faible);
    margin: 0.8rem 0 0.35rem;
  }

  .menu-mobile__groupe a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.25rem;
    font-size: 1rem;
    color: var(--texte-doux);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .menu-mobile__groupe a :global(svg) {
    color: var(--or);
    opacity: 0.8;
  }

  .menu-mobile__cta {
    display: grid;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  @media (min-width: 1060px) {
    .nav-bureau {
      display: flex;
    }

    .burger {
      display: none;
    }

    .entete__tel,
    .entete__devis {
      display: inline-flex;
    }
  }

  @media (max-width: 420px) {
    .entete__actions .entete__tel span {
      display: none;
    }
  }
</style>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const declencheur = document.querySelector<HTMLButtonElement>('[data-declencheur-menu]');
  const itemMenu = declencheur?.closest<HTMLElement>('.nav-item--menu');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menuMobile = document.querySelector<HTMLElement>('[data-menu-mobile]');

  // Ombre et opacité de l'en-tête au défilement.
  const majScroll = () => {
    if (window.scrollY > 12) entete?.setAttribute('data-scrolled', '');
    else entete?.removeAttribute('data-scrolled');
  };
  majScroll();
  window.addEventListener('scroll', majScroll, { passive: true });

  // Méga-menu : ouverture au survol comme au clavier.
  const basculerMega = (ouvert: boolean) => {
    if (!itemMenu || !declencheur) return;
    itemMenu.toggleAttribute('data-ouvert', ouvert);
    declencheur.setAttribute('aria-expanded', String(ouvert));
  };

  declencheur?.addEventListener('click', () => basculerMega(!itemMenu?.hasAttribute('data-ouvert')));
  itemMenu?.addEventListener('mouseenter', () => basculerMega(true));
  itemMenu?.addEventListener('mouseleave', () => basculerMega(false));
  itemMenu?.addEventListener('focusout', (e) => {
    if (!itemMenu.contains(e.relatedTarget as Node)) basculerMega(false);
  });

  // Menu mobile.
  const basculerMobile = (ouvert: boolean) => {
    if (!menuMobile || !burger) return;
    menuMobile.hidden = !ouvert;
    burger.setAttribute('aria-expanded', String(ouvert));
    burger.setAttribute('aria-label', ouvert ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.style.overflow = ouvert ? 'hidden' : '';
    burger.innerHTML = ouvert
      ? '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>'
      : '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>';
  };

  burger?.addEventListener('click', () => basculerMobile(menuMobile?.hidden ?? true));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    basculerMega(false);
    if (menuMobile && !menuMobile.hidden) basculerMobile(false);
  });

  // Le menu bureau reprend la main au redimensionnement.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1060 && menuMobile && !menuMobile.hidden) basculerMobile(false);
  });
</script>
