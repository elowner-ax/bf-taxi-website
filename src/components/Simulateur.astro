  }

  .champ--duo {
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .champ__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texte-3);
    padding: 0;
  }

  .champ__saisie {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--blanc);
    border: 1px solid var(--filet-fort);
    padding-inline: 0.85rem;
    transition: border-color var(--transition);
