    color: var(--texte-3);
    flex-shrink: 0;
  }

  .champ__saisie input,
  .champ__saisie select {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 0;
    background: transparent;
    border: 0;
    color: var(--texte);
