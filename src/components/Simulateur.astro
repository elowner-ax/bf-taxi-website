    text-align: center;
    padding: 0.62rem 0.8rem;
    border: 1px solid var(--filet-fort);
    background: var(--blanc);
    font-size: 0.87rem;
    font-weight: 500;
    color: var(--texte-2);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .segment input:checked + span {
    background: var(--encre);
    border-color: var(--encre);
    color: var(--blanc);
    font-weight: 600;
  }

  .segment input:focus-visible + span {
    outline: 2px solid var(--chaud);
    outline-offset: 2px;
  }

  /* Résultat */
  .simu__resultat {
    padding: 1.4rem 1.75rem 1.65rem;
    background: var(--blanc);
    border-top: 1px solid var(--encre);
  }

  .simu__invite {
    font-size: 0.92rem;
    color: var(--texte-3);
    line-height: 1.6;
  }

  .simu__prix {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .simu__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chaud);
    margin-bottom: 0.25rem;
  }

  .simu__montant {
    font-family: var(--font-titre);
    font-size: clamp(2.4rem, 6vw, 3.3rem);
    line-height: 1;
    color: var(--texte);
  }

  .simu__meta {
    font-size: 0.82rem;
    color: var(--texte-3);
    text-align: right;
    line-height: 1.5;
    max-width: 45%;
  }

  .simu__detail {
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--filet);
  }

  .simu__detail summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--chaud);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .simu__detail summary::-webkit-details-marker {
    display: none;
  }

  .simu__detail summary::before {
    content: '+';
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    line-height: 1;
  }

  .simu__detail[open] summary::before {
    content: '−';
  }

  .simu__detail ul {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.86rem;
  }

  .simu__detail li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--texte-2);
    padding-bottom: 0.4rem;
    border-bottom: 1px dotted var(--filet-fort);
  }

  .simu__detail li:last-child {
    border-bottom: 0;
  }

  .simu__detail li b {
    color: var(--texte);
    white-space: nowrap;
    font-weight: 600;
  }

  .simu__explication {
    margin-top: 0.9rem;
    padding: 0.8rem 1rem;
    background: var(--ivoire);
    border-left: 2px solid var(--chaud);
    font-size: 0.83rem;
    color: var(--texte-2);
    line-height: 1.65;
  }

  .simu__explication:empty {
    display: none;
  }

  .simu__note {
    font-size: 0.78rem;
    color: var(--texte-4);
    line-height: 1.6;
    margin-top: 1.1rem;
  }

  .simu__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.3rem;
  }

  .simu--compact .simu__devis {
    display: none;
  }

  .simu__rappel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.87rem;
    color: var(--texte-3);
  }

  @media (max-width: 560px) {
    .simu__entete,
    .simu__form,
    .simu__resultat {
      padding-inline: 1.15rem;
    }

    .champ--duo {
      grid-template-columns: 1fr;
    }

    .simu__prix {
      flex-direction: column;
      align-items: flex-start;
    }

    .simu__meta {
      text-align: left;
      max-width: 100%;
    }
  }
</style>

<script>
  import { brancherAutocompletion, type Point } from '../lib/autocomplete.ts';
  import { estTarifNuit, tarifApplicable } from '../data/tarifs.ts';

  for (const racine of document.querySelectorAll<HTMLElement>('[data-simu]')) {
    const balise = racine.querySelector<HTMLScriptElement>('[data-simu-donnees]');
    if (!balise?.textContent) continue;

    const d = JSON.parse(balise.textContent) as {
      tarifs: Record<string, { key: string; parKm: number; label: string; court: string }>;
      constantes: {
        priseEnCharge: number;
        tarifHoraire: number;
        minimumPerception: number;
        supplement4ePassager: number;
      };
      raccourcis: Point[];
      whatsapp: string;
      urlApi: string;
    };

    const $ = <T extends Element>(s: string) => racine.querySelector<T>(s);
    const euros = (n: number) =>
      new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(n);

    /* Les points retenus pour chaque extrémité du trajet. */
    const points: Record<string, Point | null> = { depart: null, arrivee: null };

    const champDate = $<HTMLInputElement>('[data-champ="date"]')!;
    const champHeure = $<HTMLInputElement>('[data-champ="heure"]')!;
    const champPassagers = $<HTMLSelectElement>('[data-champ="passagers"]')!;

    // Par défaut : maintenant, arrondi au quart d'heure suivant.
    const maintenant = new Date();
    maintenant.setMinutes(Math.ceil(maintenant.getMinutes() / 15) * 15, 0, 0);
    champDate.value = `${maintenant.getFullYear()}-${String(maintenant.getMonth() + 1).padStart(2, '0')}-${String(maintenant.getDate()).padStart(2, '0')}`;
    champHeure.value = `${String(maintenant.getHours()).padStart(2, '0')}:${String(maintenant.getMinutes()).padStart(2, '0')}`;
    champDate.min = champDate.value;

    /* --- Distance ---------------------------------------------------------
       Même méthode que src/data/geo.ts : orthodromie × coefficient de
       sinuosité calibré sur des trajets réels au départ de Saint-Étienne. */
    const COEFF_ROUTE = 1.32;
    const rad = (deg: number) => (deg * Math.PI) / 180;

    function distance(a: Point, b: Point): number {
      const dLat = rad(b.lat - a.lat);
      const dLon = rad(b.lon - a.lon);
      const h =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
      const km = 2 * 6371 * Math.asin(Math.sqrt(h)) * COEFF_ROUTE;
      return km < 50 ? Math.max(1, Math.round(km)) : Math.round(km / 5) * 5;
    }

    /* --- Autocomplétion --------------------------------------------------- */
    function brancherAdresse(cle: 'depart' | 'arrivee') {
      return brancherAutocompletion({
        input: racine.querySelector<HTMLInputElement>(`[data-adresse="${cle}"]`)!,
        liste: racine.querySelector<HTMLElement>(`[data-liste="${cle}"]`)!,
        vider: racine.querySelector<HTMLButtonElement>(`[data-vider="${cle}"]`),
        urlApi: d.urlApi,
        onChoix: (p) => {
          points[cle] = p;
          calculer();
        },
      });
    }

    brancherAdresse('depart');
    const choisirArrivee = brancherAdresse('arrivee');

    for (const b of racine.querySelectorAll<HTMLButtonElement>('[data-raccourci]')) {
      b.addEventListener('click', () => {
        const p = JSON.parse(b.dataset.raccourci!) as Point;
        choisirArrivee(p);
      });
    }

    /* --- Calcul ----------------------------------------------------------- */
    function calculer() {
      const invite = $<HTMLElement>('[data-simu-invite]')!;
      const prix = $<HTMLElement>('[data-simu-prix]')!;
      const details = $<HTMLDetailsElement>('[data-simu-details]')!;

      const a = points.depart;
      const b = points.arrivee;

      if (!a || !b) {
        invite.hidden = false;
        prix.hidden = true;
        details.hidden = true;
        return;
      }

      invite.hidden = true;
      prix.hidden = false;
      details.hidden = false;

      const km = distance(a, b);
      const allerRetour =
        racine.querySelector<HTMLInputElement>('input[name="sens"]:checked')?.value === 'ar';
      const passagers = Number(champPassagers.value) || 1;

      const priseEnCharge = new Date(`${champDate.value}T${champHeure.value || '12:00'}`);
      const dateValide = !Number.isNaN(priseEnCharge.getTime());
      const moment = dateValide ? priseEnCharge : new Date();

      const cle = tarifApplicable(moment, allerRetour);
      const tarif = d.tarifs[cle];
      const nuit = estTarifNuit(moment);

      // Sur un aller-retour, le client est à bord dans les deux sens : le
      // taximètre compte les deux trajets, au tarif réduit correspondant.
      const kmFactures = allerRetour ? km * 2 : km;

      const lignes = [
        { label: 'Prise en charge', montant: d.constantes.priseEnCharge },
        {
          label: `${kmFactures} km au ${tarif.label} (${tarif.parKm.toFixed(2).replace('.', ',')} €/km)`,
          montant: kmFactures * tarif.parKm,
        },
      ];

      let total = lignes.reduce((s, l) => s + l.montant, 0);

      if (total < d.constantes.minimumPerception) {
        lignes.push({
          label: 'Minimum de perception',
          montant: d.constantes.minimumPerception - total,
        });
        total = d.constantes.minimumPerception;
      }

      if (passagers >= 4) {
        const sup = d.constantes.supplement4ePassager * (passagers - 3);
        lignes.push({ label: `Supplément ${passagers - 3} passager(s) au-delà de 3`, montant: sup });
        total += sup;
      }

      total = Math.round(total * 100) / 100;

      $<HTMLElement>('[data-simu-total]')!.textContent = euros(total);

      const duree = Math.max(5, Math.round((km / 60) * 60));
      $<HTMLElement>('[data-simu-meta]')!.textContent =
        `${km} km environ${allerRetour ? ' × 2 (aller-retour)' : ''} · ${duree} min de trajet · ` +
        (nuit ? 'tarif nuit, dimanche ou jour férié' : 'tarif de journée');

      $<HTMLElement>('[data-simu-lignes]')!.innerHTML = lignes
        .map(
          (l) =>
            `<li><span>${l.label}</span><b>${euros(Math.round(l.montant * 100) / 100)}</b></li>`
        )
        .join('');

      // Le prix identique entre aller simple et aller-retour surprend : il
      // vaut mieux l'expliquer que de laisser croire à une erreur.
      $<HTMLElement>('[data-simu-explication]')!.textContent = allerRetour
        ? `Pourquoi le même prix qu’un aller simple ? Sur un aller-retour, vous êtes à bord dans les deux sens : le compteur tourne sur ${kmFactures} km, mais au ${tarif.label}, deux fois moins cher au kilomètre. Sur un aller simple, il ne compte que ${km} km, au tarif plein qui couvre le retour à vide du véhicule. Le kilométrage parcouru étant le même, le montant l’est aussi. Un temps d’attente sur place serait en revanche facturé ${d.constantes.tarifHoraire.toFixed(2).replace('.', ',')} € de l’heure.`
        : `Le ${tarif.label} s’applique aux courses aller simple : il intègre le retour à vide du véhicule, que vous ne payez donc pas en plus. Si vous rentrez avec nous, même plusieurs heures plus tard, signalez-le — le tarif aller-retour est plus avantageux dès qu’il y a de l’attente.`;

      /* Les boutons reprennent le trajet : rien à ressaisir. */
      const resume =
        `Bonjour, je souhaite réserver un taxi.\n` +
        `Départ : ${a.label}\n` +
        `Destination : ${b.label}\n` +
        `Prise en charge : ${dateValide ? priseEnCharge.toLocaleString('fr-FR', { dateStyle: 'full', timeStyle: 'short' }) : 'à définir'}\n` +
        `Trajet : ${allerRetour ? 'aller-retour' : 'aller simple'}\n` +
        `Passagers : ${passagers}\n` +
        `Estimation vue sur le site : ${euros(total)}`;

      $<HTMLAnchorElement>('[data-simu-wa]')!.href =
        `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(resume)}`;

      const lienDevis = $<HTMLAnchorElement>('[data-simu-devis]');
      if (lienDevis) {
        const params = new URLSearchParams({
          depart: a.label,
          arrivee: b.label,
          date: champDate.value,
          heure: champHeure.value,
          sens: allerRetour ? 'ar' : 'aller',
          passagers: String(passagers),
          estimation: String(total),
        });
        lienDevis.href = `/devis/?${params}`;
      }
    }

    racine.addEventListener('change', calculer);
    calculer();
  }
</script>
