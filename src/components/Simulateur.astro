    margin-top: 0.85rem;
    padding: 0.75rem 0.9rem;
    background: var(--ivoire);
    border-left: 2px solid var(--chaud);
    font-size: 0.84rem;
    color: var(--texte-2);
    line-height: 1.6;
  }

  .segment {
    display: flex;
    gap: 0.4rem;
  }

  .segment label {
    position: relative;
    flex: 1;
  }

  .segment input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
