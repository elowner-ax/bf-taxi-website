    display: block;
    text-align: center;
    padding: 0.62rem 0.8rem;
    border: 1px solid var(--filet-fort);
    background: var(--blanc);
    font-size: 0.87rem;
    font-weight: 500;
    color: var(--texte-2);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .segment input:checked + span {
    background: var(--encre);
    border-color: var(--encre);
    color: var(--blanc);
    font-weight: 600;
  }

  .segment input:focus-visible + span {
    outline: 2px solid var(--chaud);
    outline-offset: 2px;
  }

  /* Résultat */
  .simu__resultat {
    padding: 1.4rem 1.75rem 1.65rem;
    background: var(--blanc);
    border-top: 1px solid var(--encre);
  }

  .simu__invite {
    font-size: 0.92rem;
    color: var(--texte-3);
    line-height: 1.6;
  }

  .simu__prix {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .simu__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chaud);
    margin-bottom: 0.25rem;
  }

  .simu__montant {
    font-family: var(--font-titre);
    font-size: clamp(2.4rem, 6vw, 3.3rem);
    line-height: 1;
    color: var(--texte);
  }

  .simu__meta {
    font-size: 0.82rem;
    color: var(--texte-3);
    text-align: right;
    line-height: 1.5;
    max-width: 45%;
  }

  .simu__detail {
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--filet);
  }

  .simu__detail summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--chaud);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .simu__detail summary::-webkit-details-marker {
    display: none;
  }

  .simu__detail summary::before {
    content: '+';
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    line-height: 1;
  }

  .simu__detail[open] summary::before {
    content: '−';
  }

  .simu__detail ul {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.86rem;
  }

  .simu__detail li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--texte-2);
    padding-bottom: 0.4rem;
    border-bottom: 1px dotted var(--filet-fort);
  }

  .simu__detail li:last-child {
    border-bottom: 0;
  }

  .simu__detail li b {
    color: var(--texte);
    white-space: nowrap;
    font-weight: 600;
  }

  .simu__explication {
    margin-top: 0.9rem;
    padding: 0.8rem 1rem;
    background: var(--ivoire);
    border-left: 2px solid var(--chaud);
    font-size: 0.83rem;
    color: var(--texte-2);
    line-height: 1.65;
  }

  .simu__explication:empty {
    display: none;
  }

  .simu__note {
    font-size: 0.78rem;
    color: var(--texte-4);
    line-height: 1.6;
    margin-top: 1.1rem;
  }

  .simu__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.3rem;
  }

  .simu--compact .simu__devis {
    display: none;
  }

  /* Recommandation de véhicule, juste sous les deux sélecteurs. */
  .simu__vehicule {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    background: var(--blanc);
    border-left: 2px solid var(--encre);
    font-size: 0.85rem;
    color: var(--texte-2);
    line-height: 1.55;
  }

  .simu__nav {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--filet);
  }

  .simu__nav summary {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--texte-2);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .simu__nav summary::-webkit-details-marker {
    display: none;
  }

  .simu__nav summary::before {
    content: '+';
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    line-height: 1;
  }

  .simu__nav[open] summary::before {
    content: '−';
  }

  .simu__nav-liens {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .simu__nav-liens a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--filet);
    font-size: 0.86rem;
    color: var(--texte-2);
    transition: border-color var(--transition), color var(--transition);
  }

  .simu__nav-liens a:hover {
    border-color: var(--encre);
    color: var(--encre);
  }

  .simu__nav-liens :global(svg) {
    color: var(--encre);
    flex-shrink: 0;
  }

  .simu__rappel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.87rem;
    color: var(--texte-3);
  }

  @media (max-width: 560px) {
    .simu__entete,
    .simu__form,
    .simu__resultat {
      padding-inline: 1.15rem;
    }

    .champ--duo {
      grid-template-columns: 1fr;
    }

    .simu__prix {
      flex-direction: column;
      align-items: flex-start;
    }

    .simu__meta {
      text-align: left;
      max-width: 100%;
    }
  }
</style>

<script>
  import { brancherAutocompletion, type Point } from '../lib/autocomplete.ts';
  import {
    TARIFS,
    TARIF_CONSTANTS,
    APPROCHE,
    estTarifNuit,
    tarifApplicable,
    estimerCourse,
  } from '../data/tarifs.ts';
  import { distanceRoutiere, haversine } from '../data/geo.ts';
  import { blocNavigation, lienWaze, lienMaps, lienItineraire } from '../lib/navigation.ts';

  for (const racine of document.querySelectorAll<HTMLElement>('[data-simu]')) {
    const balise = racine.querySelector<HTMLScriptElement>('[data-simu-donnees]');
    if (!balise?.textContent) continue;

    const d = JSON.parse(balise.textContent) as {
      raccourcis: Point[];
      whatsapp: string;
      urlApi: string;
      capacites: { berline: { passagers: number; bagages: number }; van: { passagers: number; bagages: number } };
    };

    const $ = <T extends Element>(s: string) => racine.querySelector<T>(s);
    const euros = (n: number) =>
      new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(n);

    /* Les points retenus pour chaque extrémité du trajet. */
    const points: Record<string, Point | null> = { depart: null, arrivee: null };

    const champDate = $<HTMLInputElement>('[data-champ="date"]')!;
    const champHeure = $<HTMLInputElement>('[data-champ="heure"]')!;
    const champPassagers = $<HTMLSelectElement>('[data-champ="passagers"]')!;
    const champBagages = $<HTMLSelectElement>('[data-champ="bagages"]')!;

    // Par défaut : maintenant, arrondi au quart d'heure suivant.
    const maintenant = new Date();
    maintenant.setMinutes(Math.ceil(maintenant.getMinutes() / 15) * 15, 0, 0);
    champDate.value = `${maintenant.getFullYear()}-${String(maintenant.getMonth() + 1).padStart(2, '0')}-${String(maintenant.getDate()).padStart(2, '0')}`;
    champHeure.value = `${String(maintenant.getHours()).padStart(2, '0')}:${String(maintenant.getMinutes()).padStart(2, '0')}`;
    champDate.min = champDate.value;

    /* --- Autocomplétion --------------------------------------------------- */
    function brancherAdresse(cle: 'depart' | 'arrivee') {
      return brancherAutocompletion({
        input: racine.querySelector<HTMLInputElement>(`[data-adresse="${cle}"]`)!,
        liste: racine.querySelector<HTMLElement>(`[data-liste="${cle}"]`)!,
        vider: racine.querySelector<HTMLButtonElement>(`[data-vider="${cle}"]`),
        urlApi: d.urlApi,
        onChoix: (p) => {
          points[cle] = p;
          calculer();
        },
      });
    }

    const choisirDepart = brancherAdresse('depart');
    const choisirArrivee = brancherAdresse('arrivee');

    for (const b of racine.querySelectorAll<HTMLButtonElement>('[data-raccourci]')) {
      b.addEventListener('click', () => choisirArrivee(JSON.parse(b.dataset.raccourci!) as Point));
    }
    for (const b of racine.querySelectorAll<HTMLButtonElement>('[data-raccourci-depart]')) {
      b.addEventListener('click', () => choisirDepart(JSON.parse(b.dataset.raccourciDepart!) as Point));
    }

    /* --- Calcul ----------------------------------------------------------- */
    function calculer() {
      const invite = $<HTMLElement>('[data-simu-invite]')!;
      const prix = $<HTMLElement>('[data-simu-prix]')!;
      const details = $<HTMLDetailsElement>('[data-simu-details]')!;

      const a = points.depart;
      const b = points.arrivee;

      if (!a || !b) {
        invite.hidden = false;
        prix.hidden = true;
        details.hidden = true;
        return;
      }

      invite.hidden = true;
      prix.hidden = false;
      details.hidden = false;

      const km = distanceRoutiere(a, b);
      const allerRetour =
        racine.querySelector<HTMLInputElement>('input[name="sens"]:checked')?.value === 'ar';
      const passagers = Number(champPassagers.value) || 1;
      const bagages = Number(champBagages.value) || 0;

      // Orientation vers le bon véhicule : mieux vaut le dire à la
      // réservation que de le découvrir au chargement du coffre.
      const vehicule = $<HTMLElement>('[data-simu-vehicule]')!;
      const van = passagers > d.capacites.berline.passagers || bagages > d.capacites.berline.bagages;
      vehicule.hidden = false;
      vehicule.textContent = van
        ? `Avec ${passagers} passager${passagers > 1 ? 's' : ''} et ${bagages} bagage${bagages > 1 ? 's' : ''}, nous enverrons le van Mercedes 7 places. Le tarif au kilomètre est le même que pour la berline.`
        : `La berline Tesla Model 3 convient : jusqu’à ${d.capacites.berline.passagers} passagers et ${d.capacites.berline.bagages} grandes valises. Au-delà, nous envoyons le van.`;

      const priseEnCharge = new Date(`${champDate.value}T${champHeure.value || '12:00'}`);
      const dateValide = !Number.isNaN(priseEnCharge.getTime());
      const moment = dateValide ? priseEnCharge : new Date();

      const cle = tarifApplicable(moment, allerRetour);
      const tarif = TARIFS[cle];
      const nuit = estTarifNuit(moment);

      // Course d'approche : le compteur tourne dès que le taxi quitte sa
      // station. Un départ à la station même n'en paie pas.
      const aLaStation = haversine(a, APPROCHE.station) < APPROCHE.rayonStationKm;
      const approcheKm = aLaStation ? null : distanceRoutiere(APPROCHE.station, a);

      // Sur un aller-retour, le client est à bord dans les deux sens : le
      // taximètre compte les deux trajets, au tarif réduit correspondant.
      const kmFactures = allerRetour ? km * 2 : km;

      const estimation = estimerCourse({ km: kmFactures, tarif: cle, passagers, bagages, approcheKm });
      const total = estimation.total;

      $<HTMLElement>('[data-simu-total]')!.textContent = euros(total);
      $<HTMLElement>('[data-simu-eloigne]')!.hidden = !estimation.approcheEloignee;

      const duree = Math.max(5, Math.round((km / 60) * 60));
      $<HTMLElement>('[data-simu-meta]')!.textContent =
        `${km} km environ${allerRetour ? ' × 2 (aller-retour)' : ''} · ${duree} min de trajet · ` +
        (nuit ? 'tarif nuit, dimanche ou jour férié' : 'tarif de journée');

      $<HTMLElement>('[data-simu-lignes]')!.innerHTML = estimation.detail
        .map(
          (l) =>
            `<li><span>${l.label}</span><b>${euros(Math.round(l.montant * 100) / 100)}</b></li>`
        )
        .join('');

      // Le prix identique entre aller simple et aller-retour surprend : il
      // vaut mieux l'expliquer que de laisser croire à une erreur.
      const approcheTexte = aLaStation
        ? 'Départ à notre station : aucune course d’approche.'
        : `La course d’approche correspond au trajet de notre station, ${APPROCHE.stationLabel}, jusqu’à vous : le compteur tourne dès que le taxi part vous chercher.`;
      $<HTMLElement>('[data-simu-explication]')!.textContent = allerRetour
        ? `Pourquoi le même prix qu’un aller simple ? Sur un aller-retour, le taxi revient « en charge à la station », vous à bord : le compteur tourne sur ${kmFactures} km, mais au ${tarif.label}, deux fois moins cher au kilomètre. Sur un aller simple, il ne compte que ${km} km, au tarif plein qui couvre le « retour à vide ». Même kilométrage parcouru, même montant. Un temps d’attente sur place serait en revanche facturé ${TARIF_CONSTANTS.tarifHoraire.toFixed(2).replace('.', ',')} € de l’heure. ${approcheTexte}`
        : `Le ${tarif.label} s’applique aux courses aller simple : il intègre le « retour à vide à la station », que vous ne payez donc pas en plus. Si vous rentrez avec nous, même plusieurs heures plus tard, signalez-le — le tarif aller-retour est plus avantageux dès qu’il y a de l’attente. ${approcheTexte} Péages éventuels en sus, après accord.`;

      /* Les boutons reprennent le trajet : rien à ressaisir. */
      const resume =
        `Bonjour, je souhaite réserver un taxi.\n` +
        `Départ : ${a.label}\n` +
        `Destination : ${b.label}\n` +
        `Prise en charge : ${dateValide ? priseEnCharge.toLocaleString('fr-FR', { dateStyle: 'full', timeStyle: 'short' }) : 'à définir'}\n` +
        `Trajet : ${allerRetour ? 'aller-retour' : 'aller simple'}\n` +
        `Passagers : ${passagers}\n` +
        `Bagages : ${bagages || 'aucun'}\n` +
        `Véhicule adapté : ${van ? 'van Mercedes 7 places' : 'berline Tesla Model 3'}\n` +
        `Estimation vue sur le site : ${euros(total)}\n` +
        blocNavigation(a, b);

      $<HTMLAnchorElement>('[data-simu-wa]')!.href =
        `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(resume)}`;

      /* Liens de navigation : le chauffeur clique au lieu de ressaisir
         l'adresse dans son GPS. */
      const nav = $<HTMLDetailsElement>('[data-simu-nav]')!;
      nav.hidden = false;
      $<HTMLAnchorElement>('[data-nav="waze"]')!.href = lienWaze(a);
      $<HTMLAnchorElement>('[data-nav="maps"]')!.href = lienMaps(a);
      $<HTMLAnchorElement>('[data-nav="trajet"]')!.href = lienItineraire(a, b);

      const lienDevis = $<HTMLAnchorElement>('[data-simu-devis]');
      if (lienDevis) {
        const params = new URLSearchParams({
          depart: a.label,
          arrivee: b.label,
          date: champDate.value,
          heure: champHeure.value,
          sens: allerRetour ? 'ar' : 'aller',
          passagers: String(passagers),
          bagages: String(bagages),
          estimation: String(total),
        });
        lienDevis.href = `/devis/?${params}`;
      }
    }

    racine.addEventListener('change', calculer);
    calculer();
  }
</script>
