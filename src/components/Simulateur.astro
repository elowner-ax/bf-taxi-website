    padding: 1.25rem 1.75rem 1.5rem;
    display: grid;
    gap: 1.1rem;
  }

  .champ {
    position: relative;
    display: grid;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

