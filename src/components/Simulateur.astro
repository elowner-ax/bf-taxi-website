---
/**
 * Simulateur de tarif.
 *
 * Deux principes :
 *  – le visiteur saisit de vraies adresses, complétées par la Base Adresse
 *    Nationale (cf. src/lib/adresses.ts) ;
 *  – il n'a pas à savoir s'il est en tarif jour ou nuit : cela se déduit de
 *    l'heure de prise en charge, comme le fait le taximètre.
 *
 * Le calcul reste entièrement dans le navigateur : aucune donnée de trajet
 * n'est transmise ni conservée.
 */
import Icone from './Icone.astro';
import BoutonRappel from './BoutonRappel.astro';
import { CONTACT, CAPACITES } from '../data/site.ts';
import { DESTINATIONS, ARRETE, APPROCHE } from '../data/tarifs.ts';
import { COORDONNEES } from '../data/geo.ts';
import { urlRechercheBase } from '../lib/adresses.ts';

interface Props {
  /** Version resserrée pour le bandeau d'accueil. */
  compact?: boolean;
  titre?: string;
}

const { compact = false, titre = 'Estimer ma course' } = Astro.props;

// Raccourcis : points que la Base Adresse Nationale situe mal (terminaux,
// entrées de service) et qui représentent l'essentiel des demandes.
const RACCOURCIS = ['aeroport-lyon-saint-exupery', 'gare-chateaucreux', 'chu-hopital-nord', 'aeroport-saint-etienne-boutheon']
  .map((slug) => {
    const d = DESTINATIONS.find((x) => x.slug === slug);
    const c = COORDONNEES[slug];
    return d && c ? { label: d.label, court: d.label.split(' (')[0].replace('Aéroport ', '').replace('Gare de ', ''), lat: c.lat, lon: c.lon } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

// Le calcul lui-même n'est plus sérialisé : le script client importe
// directement src/data/tarifs.ts, seule source de vérité.
const donnees = {
  raccourcis: RACCOURCIS,
  whatsapp: CONTACT.whatsapp,
  urlApi: urlRechercheBase(),
  capacites: CAPACITES,
};

// Un départ à la station ne paie pas de course d'approche : le raccourci le
// rend visible, pour ceux qui arrivent en train.
const RACCOURCI_DEPART = {
  label: DESTINATIONS.find((d) => d.slug === 'gare-chateaucreux')!.label,
  court: 'Gare de Châteaucreux',
  lat: APPROCHE.station.lat,
  lon: APPROCHE.station.lon,
};
---

<div class:list={['simu', { 'simu--compact': compact }]} id="simulateur" data-simu>
  <script type="application/json" data-simu-donnees set:html={JSON.stringify(donnees)} is:inline />

  <div class="simu__entete">
    <h2>{titre}</h2>
    <span class="simu__source">Tarifs préfecture 42</span>
  </div>

  <div class="simu__form">
    <!-- Départ -->
    <div class="champ">
      <label class="champ__label" for="simu-depart">Départ</label>
      <div class="champ__saisie">
        <Icone nom="map" taille={16} class="champ__icone" />
        <input
          type="text"
          id="simu-depart"
          data-adresse="depart"
          placeholder="Votre adresse de départ"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="liste-depart"
        />
        <button type="button" class="champ__vider" data-vider="depart" hidden aria-label="Effacer le départ">
          <Icone nom="close" taille={15} />
        </button>
      </div>
      <ul class="suggestions" id="liste-depart" data-liste="depart" role="listbox" hidden></ul>

      <div class="raccourcis">
        <button type="button" data-raccourci-depart={JSON.stringify(RACCOURCI_DEPART)}>
          {RACCOURCI_DEPART.court}
        </button>
        <span class="raccourcis__note">sans course d’approche</span>
      </div>
    </div>

    <!-- Arrivée -->
    <div class="champ">
      <label class="champ__label" for="simu-arrivee">Destination</label>
      <div class="champ__saisie">
        <Icone nom="map" taille={16} class="champ__icone" />
        <input
          type="text"
          id="simu-arrivee"
          data-adresse="arrivee"
          placeholder="Adresse, gare, hôpital, aéroport…"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="liste-arrivee"
        />
        <button type="button" class="champ__vider" data-vider="arrivee" hidden aria-label="Effacer la destination">
          <Icone nom="close" taille={15} />
        </button>
      </div>
      <ul class="suggestions" id="liste-arrivee" data-liste="arrivee" role="listbox" hidden></ul>

      <div class="raccourcis">
        {
          RACCOURCIS.map((r) => (
            <button type="button" data-raccourci={JSON.stringify(r)}>
              {r.court}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Prise en charge -->
    <div class="champ champ--duo">
      <div>
        <label class="champ__label" for="simu-date">Date</label>
        <div class="champ__saisie">
          <input type="date" id="simu-date" data-champ="date" />
        </div>
      </div>
      <div>
        <label class="champ__label" for="simu-heure">Heure de prise en charge</label>
        <div class="champ__saisie">
          <input type="time" id="simu-heure" data-champ="heure" />
        </div>
      </div>
    </div>

    <!-- Type de course -->
    <fieldset class="champ">
      <legend class="champ__label">Type de course</legend>
      <div class="segment">
        <label><input type="radio" name="sens" value="aller" checked data-champ="sens" /><span>Aller simple</span></label>
        <label><input type="radio" name="sens" value="ar" data-champ="sens" /><span>Aller-retour</span></label>
      </div>
    </fieldset>

    <div class="champ champ--duo">
      <div>
        <label class="champ__label" for="simu-passagers">Passagers</label>
        <div class="champ__saisie">
          <select id="simu-passagers" data-champ="passagers">
            {[1, 2, 3, 4, 5, 6, 7].map((n) => <option value={n}>{n} passager{n > 1 ? 's' : ''}</option>)}
          </select>
        </div>
      </div>
      <div>
        <label class="champ__label" for="simu-bagages">Bagages</label>
        <div class="champ__saisie">
          <select id="simu-bagages" data-champ="bagages">
            <option value="0">Aucun</option>
            {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n}>{n} bagage{n > 1 ? 's' : ''}</option>)}
          </select>
        </div>
      </div>
    </div>

    <p class="simu__vehicule" data-simu-vehicule hidden></p>
  </div>

  <!-- Résultat -->
  <div class="simu__resultat" data-simu-resultat aria-live="polite">
    <p class="simu__invite" data-simu-invite>
      Renseignez un départ et une destination pour obtenir une estimation.
    </p>

    <div class="simu__prix" data-simu-prix hidden>
      <div>
        <p class="simu__label">Estimation</p>
        <p class="simu__montant" data-simu-total>—</p>
      </div>
      <p class="simu__meta" data-simu-meta></p>
    </div>

    <p class="simu__eloigne" data-simu-eloigne hidden>
      Départ éloigné de notre station : nous proposons généralement un <strong>forfait plus
      avantageux</strong> que le compteur. Appelez-nous, on vous le donne tout de suite.
    </p>

    <details class="simu__detail" data-simu-details hidden>
      <summary>Voir le détail du calcul</summary>
      <ul data-simu-lignes></ul>
      <p class="simu__explication" data-simu-explication></p>
    </details>

    <details class="simu__nav" data-simu-nav hidden>
      <summary>Itinéraire</summary>
      <div class="simu__nav-liens">
        <a href="#" data-nav="waze" rel="noopener" target="_blank">
          <Icone nom="route" taille={16} /> Rejoindre le départ (Waze)
        </a>
        <a href="#" data-nav="maps" rel="noopener" target="_blank">
          <Icone nom="map" taille={16} /> Rejoindre le départ (Maps)
        </a>
        <a href="#" data-nav="trajet" rel="noopener" target="_blank">
          <Icone nom="arrow" taille={16} /> Voir la course entière
        </a>
      </div>
    </details>

    <p class="simu__note">
      Indicatif : seul le taximètre fait foi à l’arrivée. Tarifs réglementés par
      l’{ARRETE.reference} {ARRETE.dateDisplay}. <strong>En transport conventionné CPAM, vous ne réglez rien</strong> :
      la course est facturée directement à l’Assurance Maladie.
    </p>

    <div class="simu__actions">
      <a href={`tel:${CONTACT.phone}`} class="btn btn-appel" data-evt="tel-simu">
        <Icone nom="phone" taille={17} /> Réserver au {CONTACT.phoneDisplay}
      </a>
      <a href="#" class="btn btn-contour" data-simu-wa rel="noopener" target="_blank">
        <Icone nom="whatsapp" taille={17} /> Envoyer
      </a>
      <a href="/devis/" class="btn btn-noir simu__devis" data-simu-devis>Demander un devis écrit</a>
    </div>

    <p class="simu__rappel">
      Pas envie de tout remplir&nbsp;?
      <BoutonRappel variante="lien" libelle="Faites-vous rappeler" />
    </p>
  </div>
</div>

<style>
  .simu {
    background: var(--ivoire);
    border: 1px solid var(--filet-fort);
  }

  .simu__entete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem 1.1rem;
    border-bottom: 1px solid var(--encre);
  }

  .simu__entete h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.5rem);
