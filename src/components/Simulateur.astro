    cursor: default;
    color: var(--texte-3);
    font-style: italic;
  }

  .raccourcis {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }

  .raccourcis button {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--filet-fort);
    background: var(--blanc);
    font-size: 0.78rem;
    color: var(--texte-2);
    transition: border-color var(--transition), color var(--transition);
  }

  .raccourcis button:hover {
    border-color: var(--encre);
    color: var(--encre);
  }

  .segment {
    display: flex;
    gap: 0.4rem;
  }

  .segment label {
    position: relative;
