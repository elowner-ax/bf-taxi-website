---
/**
 * Logotype BF Taxi. Le nom est composé en Newsreader, la localisation en
 * capitales espacées — la même hiérarchie que les titres du site.
 */
interface Props {
  /** Taille du nom en pixels. */
  taille?: number;
  /** Masque la mention « Saint-Étienne · Loire ». */
  sansBaseline?: boolean;
}

const { taille = 28, sansBaseline = false } = Astro.props;
---

<span class="logo" style={`--t:${taille}px`}>
  <span class="logo__nom">BF Taxi</span>
  {!sansBaseline && <span class="logo__baseline">Saint-Étienne · Loire</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .logo__nom {
    font-family: var(--font-titre);
    font-size: var(--t);
    letter-spacing: -0.02em;
    color: var(--texte);
    white-space: nowrap;
  }

  .logo__baseline {
    font-size: calc(var(--t) * 0.41);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texte-3);
    white-space: nowrap;
  }

  @media (max-width: 460px) {
    .logo {
      flex-direction: column;
      gap: 0.1rem;
    }

    .logo__baseline {
      font-size: calc(var(--t) * 0.34);
    }
  }
</style>
