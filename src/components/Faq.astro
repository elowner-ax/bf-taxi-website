---
/**
 * Accordéon en <details> natifs : accessible au clavier sans JavaScript, et
 * le texte des réponses reste dans le HTML — donc indexable et citable.
 */
interface Props {
  items: { question: string; reponse: string }[];
  titre?: string;
  premierOuvert?: boolean;
}

const { items, titre, premierOuvert = true } = Astro.props;
---

<div class="faq">
  {titre && <h2 class="faq__titre">{titre}</h2>}
  <div class="faq__liste">
    {
      items.map((item, i) => (
        <details class="faq__item" open={premierOuvert && i === 0}>
          <summary>
            <span>{item.question}</span>
            <span class="faq__signe" aria-hidden="true" />
          </summary>
          <div class="faq__reponse">
            <p>{item.reponse}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq__titre {
    margin-bottom: 1.75rem;
  }

  .faq__liste {
    display: grid;
    gap: 0.6rem;
  }

  .faq__item {
    border: 1px solid var(--filet);
    background: var(--blanc);
    transition: border-color var(--transition);
  }

  .faq__item[open] {
    border-color: var(--filet-fort);
    background: var(--ivoire);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.01rem;
    list-style: none;
    line-height: 1.45;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item[open] summary {
    border-bottom: 1px solid var(--filet);
  }

  /* Signe + / − dessiné en CSS, sans image ni police d'icônes. */
  .faq__signe {
    position: relative;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .faq__signe::before,
  .faq__signe::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.6px;
    background: var(--chaud);
    transform: translateY(-50%);
    transition: opacity var(--transition);
  }

  .faq__signe::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq__item[open] .faq__signe::after {
    opacity: 0;
  }

  .faq__reponse {
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .faq__reponse p {
    color: var(--texte-2);
    font-size: 0.97rem;
    line-height: 1.75;
    max-width: 74ch;
  }
</style>
