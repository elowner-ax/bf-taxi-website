---
import Icone from './Icone.astro';
import Simulateur from './Simulateur.astro';
import BoutonRappel from '../components/BoutonRappel.astro';
import { SITE, CONTACT } from '../data/site.ts';

/**
 * L'ordre du DOM est l'ordre de lecture sur mobile : titre, accroche, puis le
 * simulateur tout de suite après, et enfin les boutons, le slogan et les
 * chiffres. Sur grand écran, la grille replace le simulateur dans la colonne
 * de droite sur toute la hauteur — sans toucher à l'ordre du DOM, ce qui garde
 * l'ordre de tabulation et de lecture cohérent avec l'affichage.
 */
---

<section class="hero">
  <div class="conteneur hero__inner">
    <div class="hero__texte">
      <p class="surtitre">Taxi 24h/24 · Saint-Étienne et Loire</p>

      <h1>
        Votre taxi à<br />Saint-Étienne,<br />
        <span class="italique">24 heures sur 24.</span>
      </h1>

      <p class="hero__accroche">
        Courses en ville, gares, aéroports, longue distance — et transport médical conventionné
        CPAM. Une berline Tesla Model 3 et un van Mercedes 7 places, disponibles tous les jours de
        l’année.
      </p>
    </div>

    <div class="hero__simu">
      <Simulateur compact titre="Estimer ma course" />
    </div>

    <div class="hero__suite">
      <div class="groupe-btn hero__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-appel btn-large" data-evt="tel-hero">
          <Icone nom="phone" taille={18} />
          {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver un taxi.')}`}
          class="btn btn-contour btn-large"
          rel="noopener"
          target="_blank"
          data-evt="whatsapp-hero"
        >
          <Icone nom="whatsapp" taille={18} />
          WhatsApp
        </a>
        <BoutonRappel variante="lien" libelle="Être rappelé" />
      </div>

      <p class="hero__slogan">{SITE.slogan}</p>

      <dl class="hero__chiffres">
        <div>
          <dt>24h/24</dt>
          <dd>7j/7, jours fériés inclus</dd>
        </div>
        <div>
          <dt>0 €</dt>
          <dd>à avancer sur prescription</dd>
        </div>
        <div>
          <dt>7 places</dt>
          <dd>van Mercedes Classe V</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.75rem, 6vw, 4.75rem);
  }

  /*
   * Deux colonnes : le texte à gauche sur deux rangées (titre / suite), le
   * simulateur à droite sur toute la hauteur. La seconde rangée est en `1fr`
   * pour absorber la hauteur du simulateur sans écarter le titre de la suite.
   */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(2.25rem, 5vw, 4.25rem);
    row-gap: 0;
    align-items: start;
  }

  .hero__texte {
    grid-column: 1;
    grid-row: 1;
  }

  .hero__simu {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .hero__suite {
    grid-column: 1;
    grid-row: 2;
  }

  .hero h1 {
    max-width: 15ch;
  }

  .hero__accroche {
    font-size: clamp(1.05rem, 1.8vw, 1.19rem);
    color: var(--texte-2);
    max-width: 45ch;
    margin-top: 1.85rem;
    line-height: 1.68;
  }

  .hero__cta {
    margin-top: 2.35rem;
  }

  .hero__slogan {
    margin-top: 1.5rem;
    font-family: var(--font-titre);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--encre);
  }

  .hero__chiffres {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.75rem;
    margin-top: 3.25rem;
    padding-top: 1.85rem;
    border-top: 1px solid var(--filet);
  }

  .hero__chiffres dt {
    font-family: var(--font-titre);
    font-size: 2rem;
    color: var(--encre);
    line-height: 1.1;
  }

  .hero__chiffres dd {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    color: var(--texte-3);
  }

  /*
   * Une colonne : le simulateur vient juste sous l'accroche. Les boutons du
   * hero disparaissent, car le simulateur porte déjà l'appel, WhatsApp et le
   * rappel, et la barre fixe en bas d'écran les répète.
   */
  @media (max-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .hero__texte,
    .hero__simu,
    .hero__suite {
      grid-column: auto;
      grid-row: auto;
    }

    .hero__accroche {
      margin-top: 1.35rem;
    }

    .hero__simu {
      max-width: 560px;
      width: 100%;
      margin-top: 1.85rem;
    }

    .hero__cta {
      display: none;
    }

    .hero__slogan {
      margin-top: 2rem;
    }

    .hero__chiffres {
      margin-top: 2rem;
      padding-top: 1.5rem;
    }
  }
</style>
