---
import Icone from './Icone.astro';
import Simulateur from './Simulateur.astro';
import { CONTACT, OPENING_HOURS } from '../data/site.ts';
---

<section class="hero">
  <div class="hero__fond" aria-hidden="true">
    <div class="hero__halo hero__halo--1"></div>
    <div class="hero__halo hero__halo--2"></div>
    <div class="hero__grille"></div>
  </div>

  <div class="conteneur hero__inner">
    <div class="hero__texte">
      <p class="hero__badge">
        <Icone nom="shield" taille={15} />
        Conventionné CPAM · Agréé Assurance Maladie
      </p>

      <h1>
        Votre taxi à <span class="accent">Saint-Étienne</span><br />
        et dans toute la Loire
      </h1>

      <p class="hero__accroche">
        Transport médical conventionné, transferts aéroports et gares, longue distance.
        Tesla Model 3 et van Mercedes 7 places, disponibles {OPENING_HOURS.humanShort}.
      </p>

      <div class="groupe-btn hero__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-or btn-large" data-evt="tel-hero">
          <Icone nom="phone" taille={19} />
          {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver un taxi.')}`}
          class="btn btn-whatsapp btn-large"
          rel="noopener"
          target="_blank"
          data-evt="whatsapp-hero"
        >
          <Icone nom="whatsapp" taille={19} />
          WhatsApp
        </a>
      </div>

      <ul class="hero__points">
        <li><Icone nom="check" taille={16} /> Sans avance de frais sur prescription</li>
        <li><Icone nom="check" taille={16} /> Prix annoncé avant le départ</li>
        <li><Icone nom="check" taille={16} /> 7j/7, jours fériés inclus</li>
      </ul>
    </div>

    <div class="hero__simu">
      <Simulateur compact titre="Combien va me coûter ma course ?" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__fond {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
  }

  .hero__halo--1 {
    width: min(620px, 85vw);
    height: min(620px, 85vw);
    top: -28%;
    right: -14%;
    background: radial-gradient(circle, rgba(255, 194, 51, 0.34), transparent 68%);
  }

  .hero__halo--2 {
    width: min(520px, 75vw);
    height: min(520px, 75vw);
    bottom: -34%;
    left: -16%;
    background: radial-gradient(circle, rgba(107, 168, 255, 0.16), transparent 68%);
  }

  /* Trame fine, évoque le damier taxi sans le citer littéralement. */
  .hero__grille {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 62px 62px;
    mask-image: radial-gradient(ellipse 85% 65% at 50% 30%, #000 20%, transparent 78%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--r-full);
    background: rgba(255, 194, 51, 0.11);
    border: 1px solid rgba(255, 194, 51, 0.28);
    color: var(--or-clair);
    font-size: 0.815rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: 1.5rem;
  }

  h1 .accent {
    background: linear-gradient(105deg, var(--or-clair), var(--or) 55%, var(--or-sombre));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__accroche {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    color: var(--texte-doux);
    max-width: 52ch;
    margin-top: 1.4rem;
    line-height: 1.62;
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__points {
    list-style: none;
    padding: 0;
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    color: var(--texte-faible);
  }

  .hero__points :global(svg) {
    color: var(--succes);
    flex-shrink: 0;
  }

  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__simu {
      max-width: 560px;
      width: 100%;
    }
  }
</style>
