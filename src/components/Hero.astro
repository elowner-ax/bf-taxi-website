---
import Icone from './Icone.astro';
import Simulateur from './Simulateur.astro';
import { CONTACT } from '../data/site.ts';
---

<section class="hero">
  <div class="conteneur hero__inner">
    <div class="hero__texte">
      <p class="surtitre">Taxi conventionné · Loire 42</p>

      <h1>
        Votre taxi à<br />Saint-Étienne,<br />
        <span class="italique">24 heures sur 24.</span>
      </h1>

      <p class="hero__accroche">
        Transport médical conventionné CPAM, transferts vers les aéroports et les gares, trajets
        longue distance. Une berline Tesla Model 3 et un van Mercedes 7 places, disponibles tous
        les jours de l’année.
      </p>

      <div class="groupe-btn hero__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-appel btn-large" data-evt="tel-hero">
          <Icone nom="phone" taille={18} />
          {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver un taxi.')}`}
          class="btn btn-contour btn-large"
          rel="noopener"
          target="_blank"
          data-evt="whatsapp-hero"
        >
          <Icone nom="whatsapp" taille={18} />
          WhatsApp
        </a>
      </div>

      <dl class="hero__chiffres">
        <div>
          <dt>24h/24</dt>
          <dd>7j/7, jours fériés inclus</dd>
        </div>
        <div>
          <dt>0 €</dt>
          <dd>à avancer sur prescription</dd>
        </div>
        <div>
          <dt>7 places</dt>
          <dd>van Mercedes Classe V</dd>
        </div>
      </dl>
    </div>

    <div class="hero__simu">
      <Simulateur compact titre="Estimer ma course" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.75rem, 6vw, 4.75rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.25rem, 5vw, 4.25rem);
    align-items: start;
  }

  .hero h1 {
    max-width: 15ch;
  }

  .hero__accroche {
    font-size: clamp(1.05rem, 1.8vw, 1.19rem);
    color: var(--texte-2);
    max-width: 45ch;
    margin-top: 1.85rem;
    line-height: 1.68;
  }

  .hero__cta {
    margin-top: 2.35rem;
  }

  .hero__chiffres {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.75rem;
    margin-top: 3.25rem;
    padding-top: 1.85rem;
    border-top: 1px solid var(--filet);
  }

  .hero__chiffres dt {
    font-family: var(--font-titre);
    font-size: 2rem;
    color: var(--encre);
    line-height: 1.1;
  }

  .hero__chiffres dd {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    color: var(--texte-3);
  }

  @media (max-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__simu {
      max-width: 560px;
      width: 100%;
    }
  }
</style>
