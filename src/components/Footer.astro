---
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { SITE, CONTACT, ADDRESS, OPENING_HOURS } from '../data/site.ts';
import { servicesParCategorie } from '../data/services.ts';
import { VILLES } from '../data/villes.ts';

const annee = new Date().getFullYear();
const medical = servicesParCategorie('medical');
const transferts = [...servicesParCategorie('transfert'), ...servicesParCategorie('confort')];
---

<footer class="pied">
  <div class="conteneur">
    <div class="pied__haut">
      <div class="pied__marque">
        <Logo taille={26} sansBaseline />
        <p class="pied__slogan">{SITE.slogan}</p>
        <p class="pied__desc">{SITE.shortDescription}</p>

        <a href={`tel:${CONTACT.phone}`} class="pied__tel">{CONTACT.phoneDisplay}</a>

        <div class="pied__contacts">
          <a href={`https://wa.me/${CONTACT.whatsapp}`} rel="noopener" target="_blank">
            <Icone nom="whatsapp" taille={16} /> WhatsApp
          </a>
          <a href={`mailto:${CONTACT.email}`}>
            <Icone nom="mail" taille={16} /> {CONTACT.email}
          </a>
          <p><Icone nom="map" taille={16} /> {ADDRESS.city} ({ADDRESS.postalCode}) — {ADDRESS.department}</p>
          <p><Icone nom="clock" taille={16} /> {OPENING_HOURS.human}</p>
        </div>
      </div>

      <nav class="pied__colonnes" aria-label="Plan du site">
        <div>
          <h2>Transport médical</h2>
          <ul>{medical.map((s) => <li><a href={`/${s.slug}/`}>{s.navLabel}</a></li>)}</ul>
        </div>
        <div>
          <h2>Transferts</h2>
          <ul>{transferts.map((s) => <li><a href={`/${s.slug}/`}>{s.navLabel}</a></li>)}</ul>
        </div>
        <div>
          <h2>Informations</h2>
          <ul>
            <li><a href="/tarifs/">Tarifs et simulateur</a></li>
            <li><a href="/devis/">Demande de devis</a></li>
            <li><a href="/vehicules/">Nos véhicules</a></li>
            <li><a href="/taxi/">Zones desservies</a></li>
            <li><a href="/faq/">Questions fréquentes</a></li>
            <li><a href="/a-propos/">À propos</a></li>
            <li><a href="/contact/">Nous contacter</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="pied__villes">
      <h2>Taxi conventionné dans la Loire</h2>
      <ul>{VILLES.map((v) => <li><a href={`/taxi/${v.slug}/`}>Taxi {v.nom}</a></li>)}</ul>
    </div>

    <div class="pied__bas">
      <p>© {annee} {SITE.name}. Tous droits réservés.</p>
      <nav class="pied__legal" aria-label="Informations légales">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-de-confidentialite/">Confidentialité</a>
        <a href="/plan-du-site/">Plan du site</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .pied {
    background: var(--blanc);
    border-top: 1px solid var(--filet);
    padding-block: clamp(3rem, 6vw, 3.75rem) 2rem;
    font-size: 0.92rem;
  }

  .pied__haut {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .pied__slogan {
    font-family: var(--font-titre);
    font-style: italic;
    font-size: 1rem;
    color: var(--encre);
    margin-top: 0.55rem;
  }

  .pied__desc {
    color: var(--texte-2);
    margin-top: 0.7rem;
    max-width: 36ch;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .pied__tel {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--chaud);
  }

  .pied__tel:hover {
    color: var(--chaud-fonce);
  }

  .pied__contacts {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .pied__contacts a,
  .pied__contacts p {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--texte-2);
    font-size: 0.87rem;
    width: fit-content;
  }

  .pied__contacts :global(svg) {
    color: var(--encre);
    flex-shrink: 0;
  }

  .pied__contacts a:hover {
    color: var(--texte);
  }

  .pied__colonnes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
    gap: 2rem;
  }

  .pied__colonnes h2,
  .pied__villes h2 {
    font-family: var(--font-texte);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texte-3);
    margin-bottom: 1rem;
  }

  .pied__colonnes ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .pied__colonnes a {
    color: var(--texte-2);
    font-size: 0.89rem;
  }

  .pied__colonnes a:hover {
    color: var(--texte);
  }

  .pied__villes {
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--filet);
  }

  .pied__villes ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.45rem;
  }

  .pied__villes a {
    display: inline-block;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--filet);
    font-size: 0.81rem;
    color: var(--texte-2);
    transition: border-color var(--transition), color var(--transition);
  }

  .pied__villes a:hover {
    border-color: var(--encre);
    color: var(--encre);
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--filet);
    color: var(--texte-3);
    font-size: 0.83rem;
  }

  .pied__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .pied__legal a {
    color: var(--texte-3);
  }

  .pied__legal a:hover {
    color: var(--texte);
  }

  @media (max-width: 880px) {
    .pied__haut {
      grid-template-columns: 1fr;
    }
  }
</style>
