const tracé = tracés[nom] ?? tracés.check;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={classe}
  set:html={tracé}
/>
