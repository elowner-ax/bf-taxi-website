---
import IllustrationVehicule from './IllustrationVehicule.astro';
import { VEHICLES } from '../data/site.ts';

interface Props {
  /** Version détaillée avec description longue (page dédiée). */
  detaille?: boolean;
}

const { detaille = false } = Astro.props;
---

<div class="vehicules">
  {
    VEHICLES.map((v) => (
      <article class="vehicule reveal">
        <div class="vehicule__visuel">
          <IllustrationVehicule type={v.slug === 'tesla-model-3' ? 'berline' : 'van'} />
        </div>

        <div class="vehicule__corps">
          <div class="vehicule__titre">
            <h3>{v.name}</h3>
            <span class="badge">{v.slug === 'tesla-model-3' ? '100 % électrique' : `${v.seats} places`}</span>
          </div>
          <p class="vehicule__modele">
            {v.model} · {v.seats} passagers · {v.luggage}
          </p>

          <p class="vehicule__desc">{v.description}</p>

          {
            detaille && (
              <ul class="liste-check vehicule__points">
                {v.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )
          }

          <div class="vehicule__usages">
            {v.bestFor.map((u) => (
              <span class="puce">{u}</span>
            ))}
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .vehicules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.75rem;
  }

  .vehicule {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--filet);
    background: var(--blanc);
  }

  .vehicule__visuel {
    display: grid;
    place-items: center;
    padding: 2rem 2.25rem 0.5rem;
    background: var(--ivoire);
    border-bottom: 1px solid var(--filet);
  }

  .vehicule__corps {
    padding: 1.75rem 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .vehicule__titre {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .vehicule__titre h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.65rem);
  }

  .vehicule__modele {
    font-size: 0.87rem;
    color: var(--texte-3);
    margin-top: 0.4rem;
  }

  .vehicule__desc {
    margin-top: 1.1rem;
    color: var(--texte-2);
    font-size: 0.97rem;
    line-height: 1.72;
    flex: 1;
  }

  .vehicule__points {
    margin-top: 1.35rem;
    font-size: 0.92rem;
  }

  .vehicule__usages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--filet);
  }

  .puce {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--filet);
    font-size: 0.78rem;
    color: var(--texte-3);
  }
</style>
