---
import Icone from './Icone.astro';
import IllustrationVehicule from './IllustrationVehicule.astro';
import { VEHICLES } from '../data/site.ts';

interface Props {
  /** Version détaillée avec description longue (page dédiée). */
  detaille?: boolean;
}

const { detaille = false } = Astro.props;
---

<div class="vehicules">
  {
    VEHICLES.map((v, i) => (
      <article class="vehicule reveal" style={`transition-delay:${i * 90}ms`}>
        <div class="vehicule__visuel">
          <IllustrationVehicule type={v.slug === 'tesla-model-3' ? 'berline' : 'van'} />
          <span class="vehicule__tag">
            <Icone nom={v.slug === 'tesla-model-3' ? 'bolt' : 'users'} taille={14} />
            {v.slug === 'tesla-model-3' ? '100 % électrique' : `${v.seats} places`}
          </span>
        </div>

        <div class="vehicule__corps">
          <h3>{v.name}</h3>
          <p class="vehicule__modele">{v.model}</p>

          <div class="vehicule__stats">
            <span><Icone nom="users" taille={15} /> {v.seats} passagers</span>
            <span><Icone nom="luggage" taille={15} /> {v.luggage}</span>
          </div>

          {detaille && <p class="vehicule__desc">{v.description}</p>}

          <ul class="liste-check vehicule__points">
            {v.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          <div class="vehicule__usages">
            {v.bestFor.map((u) => (
              <span class="puce">{u}</span>
            ))}
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .vehicules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .vehicule {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-xl);
    border: 1px solid var(--bord);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition), opacity 620ms,
      translate 620ms;
  }

  .vehicule:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 194, 51, 0.34);
  }

  .vehicule__visuel {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.75rem 1.5rem 0.5rem;
    background: radial-gradient(ellipse 70% 60% at 50% 75%, rgba(255, 194, 51, 0.1), transparent 70%);
  }

  .vehicule__tag {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.75rem;
    border-radius: var(--r-full);
    background: rgba(8, 9, 12, 0.7);
    border: 1px solid rgba(255, 194, 51, 0.3);
    color: var(--or-clair);
    font-size: 0.75rem;
    font-weight: 620;
    backdrop-filter: blur(6px);
  }

  .vehicule__corps {
    padding: 1.5rem 1.75rem 1.85rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .vehicule__modele {
    color: var(--or);
    font-size: 0.87rem;
    font-weight: 600;
    margin-top: 0.25rem;
  }

  .vehicule__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    padding-block: 0.85rem;
    border-block: 1px solid var(--bord);
  }

  .vehicule__stats span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--texte-doux);
  }

  .vehicule__stats :global(svg) {
    color: var(--or);
  }

  .vehicule__desc {
    margin-top: 1.1rem;
    color: var(--texte-doux);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .vehicule__points {
    margin-top: 1.25rem;
    font-size: 0.92rem;
  }

  .vehicule__usages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--bord);
  }

  .puce {
    padding: 0.28rem 0.7rem;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--bord);
    font-size: 0.775rem;
    color: var(--texte-faible);
  }
</style>
