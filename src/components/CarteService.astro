---
import Icone from './Icone.astro';
import type { Service } from '../data/services.ts';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a href={`/${service.slug}/`} class="carte">
  <Icone nom={service.icon} taille={30} class="carte__icone" />
  <h3>{service.navLabel}</h3>
  <p>{service.accroche}</p>
  <span class="carte__lien">En savoir plus →</span>
</a>

<style>
  .carte {
    display: flex;
    flex-direction: column;
  }

  .carte :global(.carte__icone) {
    color: var(--encre);
    stroke-width: 1.3;
    margin-bottom: 1.35rem;
  }

  .carte p {
    flex: 1;
  }

  .carte__lien {
    display: block;
    margin-top: 1.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--chaud);
  }
</style>
