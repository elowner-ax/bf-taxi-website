---
/**
 * Silhouettes vectorielles des deux véhicules, en attendant les photos réelles
 * du client (voir public/images/README.md).
 *
 * Dessin au trait fin, dans la couleur d'encre du site : il tient à toutes les
 * tailles, pèse quelques kilo-octets et ne pose aucune question de droits.
 */
interface Props {
  type: 'berline' | 'van';
  class?: string;
}

const { type, class: classe = '' } = Astro.props;
---

<svg
  class:list={['illu', classe]}
  viewBox="0 0 420 170"
  role="img"
  aria-label={type === 'berline' ? 'Silhouette de la berline Tesla Model 3' : 'Silhouette du van Mercedes Classe V'}
>
  {
    type === 'berline' ? (
      <g>
        {/* Capot plongeant et pavillon fuyant d'une berline électrique */}
        <path
          d="M32 122c-4-15 2-25 14-29l44-12c14-17 34-27 60-29 30-2 54 6 72 21l52 10c22 4 36 13 42 25 3 6 2 12-4 14H40c-5 0-7-4-8-11Z"
          fill="#fff"
          stroke="var(--encre)"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path d="M104 82c12-15 30-24 52-25 24-1 44 7 58 19l-14 6-96 2Z" fill="#eef2f6" stroke="var(--encre)" stroke-width="1.4" />
        <path d="M158 57v25" stroke="var(--encre)" stroke-width="1.2" opacity="0.5" />
        <circle cx="112" cy="122" r="23" fill="#fff" stroke="var(--encre)" stroke-width="2" />
        <circle cx="112" cy="122" r="10" fill="none" stroke="var(--encre)" stroke-width="1.4" opacity="0.55" />
        <circle cx="290" cy="122" r="23" fill="#fff" stroke="var(--encre)" stroke-width="2" />
        <circle cx="290" cy="122" r="10" fill="none" stroke="var(--encre)" stroke-width="1.4" opacity="0.55" />
        <path d="M322 100h26" stroke="var(--chaud)" stroke-width="3" stroke-linecap="round" />
      </g>
    ) : (
      <g>
        {/* Volume haut et droit du van, portes coulissantes suggérées par le rail */}
        <path
          d="M30 122V64c0-12 9-21 21-21h156c10 0 19 4 25 11l33 40 44 8c17 3 27 11 30 21 2 7-2 11-9 11H38c-5 0-8-4-8-12Z"
          fill="#fff"
          stroke="var(--encre)"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <rect x="48" y="57" width="57" height="32" rx="4" fill="#eef2f6" stroke="var(--encre)" stroke-width="1.4" />
        <rect x="113" y="57" width="57" height="32" rx="4" fill="#eef2f6" stroke="var(--encre)" stroke-width="1.4" />
        <path d="M178 57h24l25 32h-49Z" fill="#eef2f6" stroke="var(--encre)" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M48 97h122" stroke="var(--encre)" stroke-width="1.4" opacity="0.45" stroke-linecap="round" />
        <circle cx="100" cy="122" r="23" fill="#fff" stroke="var(--encre)" stroke-width="2" />
        <circle cx="100" cy="122" r="10" fill="none" stroke="var(--encre)" stroke-width="1.4" opacity="0.55" />
        <circle cx="288" cy="122" r="23" fill="#fff" stroke="var(--encre)" stroke-width="2" />
        <circle cx="288" cy="122" r="10" fill="none" stroke="var(--encre)" stroke-width="1.4" opacity="0.55" />
        <path d="M330 104h26" stroke="var(--chaud)" stroke-width="3" stroke-linecap="round" />
      </g>
    )
  }
  <path d="M24 148h372" stroke="var(--filet)" stroke-width="2" />
</svg>

<style>
  .illu {
    width: 100%;
    height: auto;
    max-width: 420px;
  }
</style>
