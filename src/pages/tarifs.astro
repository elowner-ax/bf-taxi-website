---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import FilAriane from '../components/FilAriane.astro';
import Simulateur from '../components/Simulateur.astro';
import Faq from '../components/Faq.astro';
import BlocCTA from '../components/BlocCTA.astro';
import { CONTACT } from '../data/site.ts';
import { TARIFS, TARIF_CONSTANTS, ARRETE, APPROCHE, DESTINATIONS, estimerCourse, euros } from '../data/tarifs.ts';
import { faqParCategorie } from '../data/faq.ts';
import { schemaFaq, schemaTarifs } from '../lib/schema.ts';

const ariane = [
  { nom: 'Accueil', url: '/' },
  { nom: 'Tarifs', url: '/tarifs/' },
];

const faqTarifs = faqParCategorie('tarifs');

// Exemples calculés avec la même fonction que le simulateur : les montants
// affichés ne peuvent pas diverger de la grille réglementaire. Départ pris
// en centre-ville, à deux kilomètres de la station.
const APPROCHE_CENTRE_KM = 2;
const exemples = ['gare-chateaucreux', 'chu-hopital-nord', 'aeroport-saint-etienne-boutheon', 'aeroport-lyon-saint-exupery', 'lyon-centre', 'aeroport-geneve']
  .map((slug) => DESTINATIONS.find((d) => d.slug === slug))
  .filter((d): d is (typeof DESTINATIONS)[number] => Boolean(d))
  .map((d) => ({
    destination: d,
    jour: estimerCourse({ km: d.km, tarif: 'C', approcheKm: APPROCHE_CENTRE_KM }).total,
    nuit: estimerCourse({ km: d.km, tarif: 'D', approcheKm: APPROCHE_CENTRE_KM }).total,
  }));

const constantes = [
  { label: 'Prise en charge', valeur: euros(TARIF_CONSTANTS.priseEnCharge), detail: 'Facturé au départ, avant le premier kilomètre' },
  { label: 'Minimum de perception', valeur: euros(TARIF_CONSTANTS.minimumPerception), detail: 'Montant plancher d’une course, suppléments inclus' },
  { label: 'Tarif horaire', valeur: `${euros(TARIF_CONSTANTS.tarifHoraire)} / h`, detail: 'Attente sur place ou marche lente dans la circulation' },
  { label: 'Supplément passager', valeur: euros(TARIF_CONSTANTS.supplementPassager), detail: `Par personne à partir de la ${TARIF_CONSTANTS.passagersSansSupplement + 1}e transportée` },
  { label: 'Supplément bagage', valeur: euros(TARIF_CONSTANTS.supplementBagage), detail: `Par bagage au-delà de ${TARIF_CONSTANTS.bagagesSansSupplement} valises, ou nécessitant un équipement extérieur` },
];
---

<Base
  titre="Tarifs taxi Saint-Étienne et Loire 42 — Grille officielle et simulateur | BF Taxi"
  description={`Tarifs taxi réglementés dans la Loire : prise en charge ${TARIF_CONSTANTS.priseEnCharge.toFixed(2)} €, de ${TARIFS.A.parKm.toFixed(2)} à ${TARIFS.D.parKm.toFixed(2)} €/km selon le tarif. Simulateur de prix en ligne et exemples de trajets.`}
  canonical="/tarifs/"
  filAriane={ariane}
  schemas={[schemaTarifs(), schemaFaq(faqTarifs)]}
>
  <FilAriane elements={ariane} />

  <section class="tete">
    <div class="conteneur">
      <p class="surtitre">Tarifs</p>
      <h1>Des tarifs réglementés, affichés sans détour</h1>
      <p class="tete__accroche">
        Les prix des courses de taxi ne sont pas fixés par nous : ils sont plafonnés par la
        préfecture de la Loire. Ils sont donc identiques chez tous les taxis du département.
        Voici la grille en vigueur, et de quoi estimer votre course à partir de vos adresses
        réelles — le tarif de jour ou de nuit se déduit de l’heure de prise en charge, comme le
        fait le taximètre.
      </p>

      <p class="source">
        <Icone nom="doc" taille={16} />
        Source : {ARRETE.reference} {ARRETE.dateDisplay} pour le département de
        la {ARRETE.departement}. Ce sont des tarifs <strong>maximaux</strong> : le taximètre du
        véhicule fait seul foi.
      </p>
    </div>
  </section>

  <!-- Simulateur -->
  <section class="section-simu">
    <div class="conteneur conteneur-etroit">
      <Simulateur titre="Simulateur de tarif" />
    </div>
  </section>

  <!-- Grille officielle -->
  <section class="section">
    <div class="conteneur">
      <p class="surtitre reveal">Grille officielle</p>
      <h2 class="reveal">Les quatre tarifs kilométriques</h2>
      <p class="intro-section reveal">
        Le tarif appliqué dépend de deux choses : si le taxi revient « en charge » ou « à vide »
        à sa station après vous avoir déposé, et si le trajet a lieu de jour ou de nuit. Le
        taximètre bascule automatiquement. Les tarifs de nuit s’appliquent aussi les dimanches,
        les jours fériés et sur route enneigée ou verglacée.
      </p>

      <div class="grille grille-4 marge-haut">
        {
          Object.values(TARIFS).map((tarif, i) => (
            <div class="tarif reveal" style={`transition-delay:${i * 70}ms`}>
              <span class="tarif__lettre">{tarif.key}</span>
              <p class="tarif__prix">
                {tarif.parKm.toFixed(2).replace('.', ',')} <span>€ / km</span>
              </p>
              <p class="tarif__cond">{tarif.conditions}</p>
            </div>
          ))
        }
      </div>

      <div class="grille grille-4 marge-haut">
        {
          constantes.map((c) => (
            <div class="constante reveal">
              <dt>{c.label}</dt>
              <dd>{c.valeur}</dd>
              <p>{c.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="encart-info reveal">
        <Icone nom="bolt" taille={20} />
        <div>
          <h3>Pourquoi l’aller simple coûte-t-il le double au kilomètre ?</h3>
          <p>
            Parce qu’il intègre le « retour à vide à la station » : sur un aller simple, le
            chauffeur rentre seul, et ces kilomètres non facturés sont répercutés sur le prix au
            kilomètre. Sur un aller-retour, le taxi revient « en charge », vous à bord : le
            compteur tourne sur deux fois plus de kilomètres, mais à un tarif deux fois moindre.
          </p>
          <p>
            <strong>Conséquence : à kilométrage égal, un aller-retour coûte le même prix qu’un
            aller simple.</strong> Ce n’est pas une erreur d’affichage — c’est la logique de
            l’arrêté, et elle vous est favorable. Seul un temps d’attente sur place s’ajoute,
            facturé au tarif horaire.
          </p>
          <h3>Et la course d’approche ?</h3>
          <p>
            Le compteur tourne dès que le taxi quitte sa station — la {APPROCHE.stationLabel} —
            pour venir vous chercher. C’est ce qui explique les quelques euros que vous voyez au
            compteur avant même de monter. Notre simulateur les compte, avec un minimum de
            {euros(APPROCHE.minimum)} : ce qu’il affiche est un plafond, pas un plancher. Un
            départ à la gare n’en paie pas. Péages éventuels en sus, après votre accord.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Exemples -->
  <section class="section section-ivoire">
    <div class="conteneur">
      <p class="surtitre reveal">Exemples</p>
      <h2 class="reveal">Combien coûtent les trajets les plus demandés ?</h2>
      <p class="intro-section reveal">
        Estimations au départ du centre de Saint-Étienne, pour un aller simple, course d’approche
        comprise et arrondies à l’euro supérieur. Le montant réel dépend du point de prise en
        charge exact et de la circulation — il sera au pire égal, le plus souvent inférieur.
      </p>

      <div class="tableau-wrap reveal">
        <table class="tableau">
          <thead>
            <tr>
              <th scope="col">Destination</th>
              <th scope="col">Distance</th>
              <th scope="col">Durée</th>
              <th scope="col">Jour (tarif C)</th>
              <th scope="col">Nuit, dim. et fériés (tarif D)</th>
            </tr>
          </thead>
          <tbody>
            {
              exemples.map((ex) => (
                <tr>
                  <th scope="row">{ex.destination.label}</th>
                  <td>{ex.destination.km} km</td>
                  <td>{ex.destination.minutes} min</td>
                  <td class="prix">{euros(ex.jour)}</td>
                  <td class="prix">{euros(ex.nuit)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="note reveal">
        Sur les longues distances, nous proposons généralement un <strong>forfait ferme</strong>,
        communiqué avant le départ et incluant péages et carburant. Demandez-le au
        <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a> ou via le
        <a href="/devis/">formulaire de devis</a>.
      </p>
    </div>
  </section>

  <!-- Conventionné -->
  <section class="section">
    <div class="conteneur conteneur-etroit prose">
      <p class="surtitre reveal">Transport conventionné</p>
      <h2 class="reveal">Et si mon transport est pris en charge par la CPAM ?</h2>
      <p class="reveal">
        Dans ce cas, les montants ci-dessus ne vous concernent pas directement :
        <strong>vous ne réglez rien au moment de la course</strong>. Nous facturons l’Assurance
        Maladie dans le cadre du tiers payant, sur la base d’une convention nationale qui applique
        un abattement sur le tarif préfectoral.
      </p>
      <p class="reveal">
        Reste éventuellement à votre charge le ticket modérateur, c’est-à-dire la part non
        remboursée par l’Assurance Maladie — généralement 35 % hors affection de longue durée. Il
        est le plus souvent pris en charge par votre complémentaire santé. En ALD, accident du
        travail, maladie professionnelle ou maternité, la prise en charge est intégrale.
      </p>
      <p class="reveal">
        <a href="/taxi-conventionne-cpam/">Tout savoir sur le transport conventionné CPAM</a>
      </p>
    </div>
  </section>

  <section class="section section-ivoire">
    <div class="conteneur conteneur-etroit">
      <div class="reveal">
        <Faq items={faqTarifs} titre="Tarifs et paiement : vos questions" />
      </div>
    </div>
  </section>

  <BlocCTA
    titre="Un prix ferme avant de partir ?"
    texte="Donnez-nous votre trajet : nous vous annonçons un montant, par téléphone, WhatsApp ou par écrit via le formulaire de devis."
  />
</Base>

<style>
  .tete {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.25rem);
  }

  .tete h1 {
    max-width: 20ch;
  }

  .tete__accroche {
    font-size: clamp(1.02rem, 2vw, 1.15rem);
    color: var(--texte-2);
    max-width: 66ch;
    margin-top: 1.2rem;
    line-height: 1.7;
  }

  .source {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding: 0.7rem 1.05rem;
    border-radius: var(--r);
    background: var(--blanc);
    border: 1px solid var(--filet);
    font-size: 0.86rem;
    color: var(--texte-3);
    max-width: 72ch;
  }

  .source :global(svg) {
    color: var(--chaud);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .section-simu {
    padding-block: clamp(1rem, 2vw, 1.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .marge-haut {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* Cartes de tarif */
  .tarif {
    position: relative;
    padding: 1.6rem 1.5rem;
    border-radius: var(--r);
    border: 1px solid var(--filet);
    background: linear-gradient(155deg, var(--blanc), var(--blanc));
    overflow: hidden;
  }

  .tarif__lettre {
    position: absolute;
    top: 0.35rem;
    right: 1rem;
    font-family: var(--font-titre);
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--filet);
  }

  .tarif__prix {
    font-family: var(--font-titre);
    font-size: 1.95rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--chaud);
    line-height: 1;
  }

  .tarif__prix span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--texte-2);
    letter-spacing: 0;
  }

  .tarif__cond {
    margin-top: 0.85rem;
    font-size: 0.87rem;
    color: var(--texte-3);
    line-height: 1.55;
    position: relative;
  }

  /* Constantes */
  .constante {
    padding: 1.3rem 1.4rem;
    border-radius: var(--r);
    border: 1px solid var(--filet);
    background: var(--blanc);
  }

  .constante dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texte-3);
  }

  .constante dd {
    margin: 0.4rem 0 0.5rem;
    font-family: var(--font-titre);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--texte);
  }

  .constante p {
    font-size: 0.82rem;
    color: var(--texte-3);
    line-height: 1.5;
  }

  .encart-info {
    display: flex;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1.6rem 1.75rem;
    border-radius: var(--r);
    background: var(--ivoire);
    border: 0;
    border-left: 3px solid var(--chaud);
  }

  .encart-info > :global(svg) {
    color: var(--chaud);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .encart-info h3 {
    font-size: 1.08rem;
    margin-bottom: 0.55rem;
  }

  .encart-info p {
    color: var(--texte-2);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 78ch;
  }

  /* Tableau */
  .tableau-wrap {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    overflow-x: auto;
    border-radius: var(--r);
    border: 1px solid var(--filet);
    background: #fff;
  }

  .tableau {
    width: 100%;
    border-collapse: collapse;
    min-width: 660px;
    font-size: 0.92rem;
  }

  .tableau th,
  .tableau td {
    padding: 0.95rem 1.15rem;
    text-align: left;
  }

  .tableau thead th {
    font-family: var(--font-titre);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--texte-2);
    background: #f2f1ea;
    border-bottom: 1px solid var(--filet);
    white-space: nowrap;
  }

  .tableau tbody tr + tr {
    border-top: 1px solid var(--filet);
  }

  .tableau tbody th {
    font-weight: 620;
    color: var(--texte);
  }

  .tableau td {
    color: var(--texte-2);
    white-space: nowrap;
  }

  .tableau .prix {
    font-family: var(--font-titre);
    font-weight: 700;
    font-size: 1rem;
    color: var(--texte);
  }

  .note {
    margin-top: 1.75rem;
    font-size: 0.94rem;
    color: var(--texte-2);
    max-width: 76ch;
    line-height: 1.7;
  }

  .note a {
    color: #a06f00;
    font-weight: 620;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
