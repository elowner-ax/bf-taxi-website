---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icone from '../components/Icone.astro';
import CarteService from '../components/CarteService.astro';
import Vehicules from '../components/Vehicules.astro';
import Faq from '../components/Faq.astro';
import BlocCTA from '../components/BlocCTA.astro';
import { SITE, TRUST_POINTS } from '../data/site.ts';
import { servicesParCategorie } from '../data/services.ts';
import { VILLES } from '../data/villes.ts';
import { FAQ_GENERALE } from '../data/faq.ts';
import { schemaFaq } from '../lib/schema.ts';

const medical = servicesParCategorie('medical');
const autres = [...servicesParCategorie('quotidien'), ...servicesParCategorie('transfert'), ...servicesParCategorie('confort')];
const faqAccueil = FAQ_GENERALE.slice(0, 6);

const etapes = [
  {
    titre: 'Vous appelez ou écrivez',
    texte: 'Téléphone, WhatsApp ou formulaire en ligne. Indiquez la date, l’heure et les deux adresses.',
    icone: 'phone',
  },
  {
    titre: 'Nous confirmons',
    texte: 'Créneau, véhicule et prix estimé vous sont confirmés immédiatement, avant toute réservation ferme.',
    icone: 'check',
  },
  {
    titre: 'Nous venons vous chercher',
    texte: 'Prise en charge à l’adresse convenue, à l’heure convenue. Nous vous prévenons à notre arrivée.',
    icone: 'car',
  },
  {
    titre: 'Vous réglez — ou pas',
    texte: 'Carte, espèces ou virement. En transport conventionné avec prescription, vous ne réglez rien.',
    icone: 'euro',
  },
];
---

<Base
  titre={`Taxi Saint-Étienne 24h/24 — Toutes courses, conventionné CPAM | ${SITE.name}`}
  description={SITE.shortDescription}
  canonical="/"
  schemas={[schemaFaq(faqAccueil)]}
>
  <Hero />

  <!-- Réassurance -->
  <section class="section-ivoire section-fine">
    <div class="conteneur">
      <div class="grille grille-4">
        {
          TRUST_POINTS.map((point, i) => (
            <div class="reassurance reveal" style={`transition-delay:${i * 70}ms`}>
              <span class="icone-carte">
                <Icone nom={point.icon} taille={21} />
              </span>
              <h2>{point.title}</h2>
              <p>{point.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pour qui ? — trois publics, chacun reconnaît son cas en une lecture -->
  <section class="section">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Un taxi pour tous vos trajets</p>
          <h2>Quel que soit le motif, on vient vous chercher</h2>
        </div>
      </div>

      <div class="grille grille-3 marge-haut">
        <a href="/taxi-en-ville/" class="carte publics reveal">
          <Icone nom="car" taille={30} class="publics__icone" />
          <h3>Au quotidien</h3>
          <p>
            Courses en ville, sorties, rendez-vous, retour de soirée ou de gare. Le taxi tout
            simplement : sans prescription, souvent dans l’heure.
          </p>
          <span class="publics__lien">Courses en ville →</span>
        </a>
        <a href="/taxi-aeroport-lyon-saint-exupery/" class="carte publics reveal" style="transition-delay:70ms">
          <Icone nom="plane" taille={30} class="publics__icone" />
          <h3>En déplacement</h3>
          <p>
            Châteaucreux, Part-Dieu, Perrache ; aéroports de Lyon, Genève et Clermont-Ferrand ;
            longue distance au forfait, prix connu avant le départ.
          </p>
          <span class="publics__lien">Gares et aéroports →</span>
        </a>
        <a href="/taxi-conventionne-cpam/" class="carte publics reveal" style="transition-delay:140ms">
          <Icone nom="shield" taille={30} class="publics__icone" />
          <h3>Pour vos soins</h3>
          <p>
            Transport médical conventionné CPAM : dialyse, oncologie, hospitalisation. Sans avance
            de frais avec votre prescription.
          </p>
          <span class="publics__lien">Transport conventionné →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Transport médical : le pilier -->
  <section class="section section-ivoire">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Transport médical conventionné</p>
          <h2>Conventionné par l’Assurance Maladie</h2>
          <p class="intro-section">
            Avec une prescription médicale de transport, vos trajets de soins sont pris en charge
            par la CPAM. Nous facturons directement votre caisse : vous n’avancez aucun frais et
            n’avez aucun dossier de remboursement à monter.
          </p>
        </div>
        <a href="/taxi-conventionne-cpam/" class="btn btn-contour">
          Comment ça marche
          <Icone nom="arrow" taille={17} />
        </a>
      </div>

      <div class="grille grille-3 marge-haut">
        {medical.map((service, i) => (
          <div class="reveal" style={`transition-delay:${i * 70}ms`}>
            <CarteService service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Autres services -->
  <section class="section">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Courses & transferts</p>
          <h2>En ville, en gare, à l’aéroport, sur la route</h2>
          <p class="intro-section">
            Prix annoncé avant le départ, suivi des vols et des trains, van 7 places pour les
            groupes et les familles chargées.
          </p>
        </div>
      </div>

      <div class="grille grille-4 marge-haut">
        {autres.map((service, i) => (
          <div class="reveal" style={`transition-delay:${i * 60}ms`}>
            <CarteService service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Véhicules -->
  <section class="section">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Nos véhicules</p>
          <h2>Une berline électrique, un van 7 places</h2>
          <p class="intro-section">
            Deux véhicules récents, entretenus et non-fumeurs. Vous choisissez selon le nombre de
            passagers, le volume de bagages et le confort recherché.
          </p>
        </div>
        <a href="/vehicules/" class="btn btn-contour">
          Voir le détail
          <Icone nom="arrow" taille={17} />
        </a>
      </div>

      <div class="marge-haut">
        <Vehicules />
      </div>
    </div>
  </section>

  <!-- Déroulement -->
  <section class="section section-encre">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Comment réserver</p>
          <h2>Quatre étapes, pas une de plus</h2>
        </div>
      </div>

      <ol class="etapes marge-haut">
        {
          etapes.map((etape, i) => (
            <li class="etape reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="etape__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="etape__trait" />
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Zones desservies -->
  <section class="section">
    <div class="conteneur">
      <div class="entete-section reveal">
        <div>
          <p class="surtitre">Zones desservies</p>
          <h2>Saint-Étienne, la Loire et bien au-delà</h2>
          <p class="intro-section">
            Nous intervenons sur tout le bassin stéphanois, la vallée du Gier, l’Ondaine, le Forez
            et le Roannais. Pour la longue distance, toute la France.
          </p>
        </div>
        <a href="/taxi/" class="btn btn-contour">
          Toutes les communes
          <Icone nom="arrow" taille={17} />
        </a>
      </div>

      <ul class="villes marge-haut reveal">
        {
          VILLES.map((ville) => (
            <li>
              <a href={`/taxi/${ville.slug}/`}>
                <Icone nom="map" taille={15} />
                <span>
                  <strong>{ville.nom}</strong>
                  <small>{ville.codePostal}{ville.distanceKm > 0 && ` · ${ville.distanceKm} km`}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-ivoire">
    <div class="conteneur conteneur-etroit">
      <p class="surtitre reveal">Questions fréquentes</p>
      <div class="reveal">
        <Faq items={faqAccueil} titre="Ce que l’on nous demande le plus souvent" />
      </div>
      <p class="faq__plus reveal">
        <a href="/faq/">Voir toutes les questions <Icone nom="arrow" taille={16} /></a>
      </p>
    </div>
  </section>

  <BlocCTA />
</Base>

<style>
  .section-fine {
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
    border-block: 1px solid var(--filet);
  }

  .reassurance h2 {
    font-size: 1.06rem;
    font-family: var(--font-titre);
    margin-bottom: 0.45rem;
  }

  .reassurance p {
    font-size: 0.92rem;
    color: var(--texte-3);
    line-height: 1.6;
  }

  .publics {
    display: flex;
    flex-direction: column;
  }

  .publics :global(.publics__icone) {
    color: var(--encre);
    stroke-width: 1.3;
    margin-bottom: 1.35rem;
  }

  .publics p {
    flex: 1;
  }

  .publics__lien {
    display: block;
    margin-top: 1.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--chaud);
  }

  .entete-section {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .marge-haut {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* Étapes — sur fond encre, les numéros portent le rythme. */
  .etapes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2rem;
  }

  .etape__num {
    display: block;
    font-family: var(--font-titre);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--chaud-clair);
  }

  .etape__trait {
    display: block;
    height: 1px;
    background: rgba(255, 255, 255, 0.28);
    margin: 1.1rem 0;
  }

  .etape h3 {
    font-size: 1.3rem;
    margin-bottom: 0.55rem;
  }

  .etape p {
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* Villes */
  .villes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(196px, 1fr));
    gap: 0.6rem;
  }

  .villes a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    border-radius: var(--r);
    border: 1px solid var(--filet);
    background: var(--blanc);
    transition: border-color var(--transition), background-color var(--transition);
  }

  .villes a:hover {
    border-color: var(--encre);
    background: var(--ivoire);
  }

  .villes :global(svg) {
    color: var(--chaud);
    flex-shrink: 0;
  }

  .villes span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .villes strong {
    font-size: 0.925rem;
    font-weight: 600;
  }

  .villes small {
    font-size: 0.76rem;
    color: var(--texte-3);
  }

  .faq__plus {
    margin-top: 1.75rem;
    text-align: center;
  }

  .faq__plus a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 620;
    color: var(--chaud);
    transition: gap var(--transition);
  }

  .faq__plus a:hover {
    gap: 0.75rem;
  }
</style>
