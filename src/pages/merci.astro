---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { CONTACT, OPENING_HOURS } from '../data/site.ts';
import { SERVICES } from '../data/services.ts';

const suggestions = SERVICES.slice(0, 3);
---

<Base
  titre="Demande envoyée — BF Taxi"
  description="Votre demande de devis a bien été transmise à BF Taxi."
  canonical="/merci/"
  noindex
>
  <section class="merci">
    <div class="conteneur conteneur-etroit">
      <div class="merci__icone">
        <Icone nom="check" taille={38} />
      </div>

      <h1>Demande bien reçue</h1>
      <p class="merci__texte">
        Merci. Nous revenons vers vous rapidement avec un prix et un créneau. Si votre trajet est
        urgent ou prévu dans les prochaines heures, appelez-nous directement : c’est le moyen le
        plus sûr d’obtenir une réponse immédiate.
      </p>

      <div class="groupe-btn merci__cta">
        <a href={`tel:${CONTACT.phone}`} class="btn btn-appel btn-large">
          <Icone nom="phone" taille={19} />
          {CONTACT.phoneDisplay}
        </a>
        <a
          href={`https://wa.me/${CONTACT.whatsapp}`}
          class="btn btn-contour btn-large"
          rel="noopener"
          target="_blank"
        >
          <Icone nom="whatsapp" taille={19} />
          WhatsApp
        </a>
      </div>

      <p class="merci__dispo">
        <Icone nom="clock" taille={16} />
        Joignables {OPENING_HOURS.human}
      </p>

      <div class="merci__suite">
        <h2>En attendant</h2>
        <ul>
          {suggestions.map((s) => (
            <li>
              <a href={`/${s.slug}/`}>
                <Icone nom={s.icon} taille={18} />
                <span>
                  <strong>{s.navLabel}</strong>
                  <small>{s.accroche}</small>
                </span>
                <Icone nom="arrow" taille={16} />
              </a>
            </li>
          ))}
        </ul>
        <p><a href="/" class="merci__retour">← Retour à l’accueil</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .merci {
    padding-block: clamp(3rem, 8vw, 6rem);
    text-align: center;
  }

  .merci__icone {
    display: grid;
    place-items: center;
    width: 86px;
    height: 86px;
    margin: 0 auto 2rem;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--ivoire), var(--ivoire));
    border: 1px solid var(--ivoire);
    color: var(--succes);
  }

  .merci__texte {
    color: var(--texte-2);
    font-size: 1.06rem;
    line-height: 1.75;
    margin: 1.2rem auto 0;
    max-width: 58ch;
  }

  .merci__cta {
    justify-content: center;
    margin-top: 2rem;
  }

  .merci__dispo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.88rem;
    color: var(--texte-3);
  }

  .merci__dispo :global(svg) {
    color: var(--chaud);
  }

  .merci__suite {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--filet);
    text-align: left;
  }

  .merci__suite h2 {
    font-size: 1.1rem;
    margin-bottom: 1.1rem;
  }

  .merci__suite ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .merci__suite a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.15rem;
    border-radius: var(--r);
    border: 1px solid var(--filet);
    background: var(--blanc);
    transition: border-color var(--transition);
  }

  .merci__suite a:hover {
    border-color: var(--filet);
  }

  .merci__suite :global(svg) {
    color: var(--chaud);
    flex-shrink: 0;
  }

  .merci__suite span {
    display: flex;
    flex-direction: column;
    flex: 1;
    line-height: 1.4;
  }

  .merci__suite small {
    font-size: 0.83rem;
    color: var(--texte-3);
  }

  .merci__retour {
    display: inline-block;
    margin-top: 1.75rem;
    color: var(--chaud);
    font-weight: 600;
  }
</style>
